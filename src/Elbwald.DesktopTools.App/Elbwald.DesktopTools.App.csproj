<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>

        <!-- Dynamic modules and reflection make trimming/single-file publishing unsuitable. -->
        <PublishSingleFile>false</PublishSingleFile>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishReadyToRun>false</PublishReadyToRun>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets/**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Elbwald.DesktopTools.Contracts/Elbwald.DesktopTools.Contracts.csproj" />
        <ProjectReference Include="../Elbwald.DesktopTools.Core/Elbwald.DesktopTools.Core.csproj" />
        <ProjectReference Include="../Elbwald.DesktopTools.UI/Elbwald.DesktopTools.UI.csproj" />
    </ItemGroup>

    <!--
      Every first-party module directly below src/Modules is discovered automatically.
      ReferenceOutputAssembly=false keeps module assemblies out of the host dependency graph;
      they are still built before the host and loaded only through ModuleLoader at runtime.
    -->
    <ItemGroup>
        <ElbwaldModuleProject Include="$(MSBuildProjectDirectory)/../Modules/*/*.csproj" />
        <ProjectReference
            Include="@(ElbwaldModuleProject)"
            ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target
        Name="CopyDevelopmentModules"
        AfterTargets="Build"
        Condition="'$(DesignTimeBuild)' != 'true'">

        <!--
          Development builds update module output in place. Do not delete the whole
          Modules tree here: native/runtime files of a loaded module can make a
          recursive RemoveDir unreliable on some development filesystems.
          Publish still performs a clean rebuild of the module destination below.
        -->
        <MakeDir Directories="$(TargetDir)Modules" />

        <MSBuild
            Projects="@(ElbwaldModuleProject)"
            Targets="CopyElbwaldModuleToHost"
            BuildInParallel="true"
            Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);ElbwaldModuleDestinationRoot=$(TargetDir)Modules/" />
    </Target>

    <Target
        Name="CopyPublishModules"
        AfterTargets="Publish"
        Condition="'$(DesignTimeBuild)' != 'true'">

        <!-- Publish output must be reproducible and must not retain removed modules. -->
        <RemoveDir Directories="$(PublishDir)Modules" />
        <MakeDir Directories="$(PublishDir)Modules" />

        <MSBuild
            Projects="@(ElbwaldModuleProject)"
            Targets="CopyElbwaldModuleToHost"
            BuildInParallel="true"
            Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);ElbwaldModuleDestinationRoot=$(PublishDir)Modules/" />
    </Target>

</Project>
