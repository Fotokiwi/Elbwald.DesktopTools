<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
        x:Class="Elbwald.DesktopTools.App.Views.MediaViewerWindow"
        x:DataType="vm:MediaViewerViewModel"
        Title="Elbwald Digital – Großansicht"
        Width="1280"
        Height="820"
        MinWidth="760"
        MinHeight="520"
        Background="{DynamicResource ElbwaldViewerChromeBrush}"
        KeyDown="OnKeyDown"
        Closed="OnClosed">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="14,10" Background="{DynamicResource ElbwaldViewerToolbarBrush}" IsVisible="{Binding ShowControls}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <Button Content="‹" FontSize="22" Width="44" Click="OnPreviousClick" IsEnabled="{Binding CanNavigate}" />
                <Button Grid.Column="1" Content="›" FontSize="22" Width="44" Click="OnNextClick" IsEnabled="{Binding CanNavigate}" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource ElbwaldViewerMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ComboBox Grid.Column="3" Width="82" ItemsSource="{Binding PresentationIntervals}" SelectedItem="{Binding SelectedIntervalSeconds}" />
                <TextBlock Grid.Column="4" Text="Sek." Foreground="{DynamicResource ElbwaldViewerTextBrush}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="5" Content="Zufällig" IsChecked="{Binding RandomOrder}" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6"
                           Text="{Binding RatingText}"
                           Foreground="{DynamicResource ElbwaldViewerRatingBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="7"
                        Content="Schnelltagging"
                        Command="{Binding ToggleQuickEditCommand}" />
                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="8">
                    <Button Content="Präsentation" Click="OnPresentationClick" />
                    <Button Content="Vollbild  F11" Click="OnFullscreenClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource ElbwaldViewerCanvasBrush}" PointerPressed="OnImageAreaPointerPressed">
            <Image Source="{Binding Image}"
                   Stretch="Uniform"
                   Margin="12" />
            <StackPanel IsVisible="{Binding HasNoImage}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="Keine Großansicht verfügbar" Foreground="White" FontSize="20" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ElbwaldViewerMutedBrush}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
            </StackPanel>

            <Border IsVisible="{Binding ShowQuickEditPanel}"
                    Width="350"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Padding="14"
                    CornerRadius="12"
                    Background="{DynamicResource ElbwaldViewerPanelBrush}"
                    BorderBrush="{DynamicResource ElbwaldViewerPanelBorderBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Schnelltagging" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Bleibt intern in Elbwald · Originaldatei unverändert" Foreground="{DynamicResource ElbwaldViewerMutedBrush}" FontSize="9" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="×" Command="{Binding ToggleQuickEditCommand}" Width="30" Height="28" Padding="0" />
                    </Grid>

                    <TextBlock Text="Bewertung" Foreground="{DynamicResource ElbwaldViewerMutedBrush}" FontSize="9" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="0" ToolTip.Tip="Taste 0" Command="{Binding SetRatingCommand}" CommandParameter="0" MinWidth="34" />
                        <Button Content="★" ToolTip.Tip="Taste 1" Command="{Binding SetRatingCommand}" CommandParameter="1" MinWidth="40" />
                        <Button Content="★★" ToolTip.Tip="Taste 2" Command="{Binding SetRatingCommand}" CommandParameter="2" MinWidth="50" />
                        <Button Content="★★★" ToolTip.Tip="Taste 3" Command="{Binding SetRatingCommand}" CommandParameter="3" MinWidth="62" />
                    </StackPanel>

                    <Grid ColumnDefinitions="95,*,Auto" ColumnSpacing="6">
                        <ComboBox ItemsSource="{Binding QuickKnowledgeKinds}"
                                  SelectedItem="{Binding QuickKnowledgeKind, Mode=TwoWay}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding QuickKnowledgeText, Mode=TwoWay}"
                                 PlaceholderText="Zuweisen …" />
                        <Button Grid.Column="2" Content="+" Command="{Binding AddQuickKnowledgeCommand}" Width="34" />
                    </Grid>

                    <TextBlock Text="Zuletzt / häufig" Foreground="{DynamicResource ElbwaldViewerMutedBrush}" FontSize="9" />
                    <ItemsControl ItemsSource="{Binding QuickKnowledgeItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:QuickKnowledgeItemViewModel">
                                <Button Margin="0,0,6,6"
                                        Padding="7,3"
                                        Command="{Binding ApplyCommand}">
                                    <TextBlock Text="{Binding Name}" FontSize="9" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding KnowledgeSummary}" Foreground="White" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding QuickEditStatus}" Foreground="{DynamicResource ElbwaldViewerMutedBrush}" FontSize="9" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding IsPresentationRunning}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,22"
                    Padding="14,8"
                    CornerRadius="18"
                    Background="{DynamicResource ElbwaldViewerHintBrush}">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="Präsentation läuft" Foreground="White" VerticalAlignment="Center" />
                    <Button Content="Pause  Leertaste" Click="OnPresentationClick" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="14,8" Background="{DynamicResource ElbwaldViewerToolbarBrush}" IsVisible="{Binding ShowControls}">
            <Grid ColumnDefinitions="*,Auto,*">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource ElbwaldViewerMutedBrush}" FontSize="11" />
                <TextBlock Grid.Column="1" Text="{Binding PositionText}" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="0–3 bewerten · ←/→ wechseln · Leertaste Präsentation · F11 Vollbild · Esc zurück" Foreground="{DynamicResource ElbwaldViewerMutedBrush}" FontSize="10" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
