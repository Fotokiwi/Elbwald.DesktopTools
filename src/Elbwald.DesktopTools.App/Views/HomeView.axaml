<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
    x:Class="Elbwald.DesktopTools.App.Views.HomeView"
    x:DataType="vm:HomeViewModel">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel
            Margin="38,30,38,34"
            MaxWidth="1280"
            HorizontalAlignment="Center"
            Spacing="22">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" MinHeight="130">
                <StackPanel
                    MaxWidth="760"
                    HorizontalAlignment="Left"
                    Spacing="7"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Willkommen"
                        Classes="elbwald-title"
                        FontSize="40" />

                    <TextBlock
                        Text="Deine Medien an einem Ort – und alles, was du damit tun möchtest."
                        Foreground="{DynamicResource ElbwaldTextBrush}"
                        FontSize="20"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="Analysiere, organisiere, bearbeite und sichere deine Medien lokal, übersichtlich und nachvollziehbar."
                        Classes="elbwald-muted"
                        FontSize="13"
                        LineHeight="19"
                        MaxWidth="700"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="0,6,6,0"
                    Spacing="4"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right">
                    <TextBlock
                        Text="Deine&#x0a;Erinnerungen&#x0a;in guten Händen."
                        Foreground="{DynamicResource ElbwaldTextBrush}"
                        FontSize="20"
                        FontFamily="URW Chancery L, Segoe Script, Brush Script MT, Comic Sans MS"
                        FontStyle="Italic"
                        FontWeight="SemiBold"
                        TextAlignment="Right"
                        Opacity="0.82" />
                    <PathIcon
                        Data="{StaticResource ElbwaldIconTree}"
                        Width="18"
                        Height="18"
                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                        HorizontalAlignment="Right"
                        Opacity="0.78" />
                </StackPanel>
            </Grid>

            <Grid
                ColumnDefinitions="1.05*,1.6*,1.05*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="16"
                RowSpacing="16">

                <Button
                    Classes="elbwald-home-card"
                    VerticalAlignment="Top"
                    Padding="18"
                    Command="{Binding OpenAnalyzeCommand}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
                        <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="14">
                            <Border
                                Width="58"
                                Height="58"
                                CornerRadius="18"
                                Background="{DynamicResource ElbwaldAccentSoftBrush}">
                                <PathIcon
                                    Data="{StaticResource ElbwaldIconSearch}"
                                    Width="28"
                                    Height="28"
                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="Neue Medien prüfen"
                                    Foreground="{DynamicResource ElbwaldTextBrush}"
                                    FontSize="17"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Formate, Metadaten und&#x0a;Auffälligkeiten analysieren."
                                    Classes="elbwald-muted"
                                    FontSize="11"
                                    LineHeight="16"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <PathIcon
                                Grid.Column="2"
                                Data="{StaticResource ElbwaldIconArrowRight}"
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                VerticalAlignment="Top" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            CornerRadius="12"
                            ClipToBounds="True"
                            Height="86">
                            <Image
                                Source="/Assets/Branding/home-analysis-jungle.png"
                                Stretch="UniformToFill" />
                        </Border>

                        <Border
                            Grid.Row="2"
                            Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                            BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8">
                            <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                                <PathIcon
                                    Data="{StaticResource ElbwaldIconSearch}"
                                    Width="16"
                                    Height="16"
                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock
                                        Text="Letzte Analyse"
                                        Foreground="{DynamicResource ElbwaldTextBrush}"
                                        FontSize="10.5"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{Binding LastAnalysisPathText}"
                                        Classes="elbwald-muted"
                                        FontSize="10"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{Binding LastAnalysisSummaryText}"
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        FontSize="9.5"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding LastAnalysisAgeText}"
                                    Classes="elbwald-muted"
                                    FontSize="9.5"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </Grid>
                </Button>

                <Border
                    Grid.Column="1"
                    Grid.RowSpan="2"
                    Classes="elbwald-card"
                    Padding="20">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                        <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="14">
                            <Border
                                Width="64"
                                Height="64"
                                CornerRadius="20"
                                Background="{DynamicResource ElbwaldAccentSoftBrush}">
                                <PathIcon
                                    Data="{StaticResource ElbwaldIconCamera}"
                                    Width="30"
                                    Height="30"
                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="4"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="Deine Galerie"
                                    Foreground="{DynamicResource ElbwaldTextBrush}"
                                    FontSize="26"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Alle deine Fotos, Videos und Audios ganz einfach durchsuchen."
                                    Classes="elbwald-muted"
                                    FontSize="13"
                                    LineHeight="18"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <PathIcon
                                Grid.Column="2"
                                Data="{StaticResource ElbwaldIconArrowRight}"
                                Width="20"
                                Height="20"
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                VerticalAlignment="Top" />
                        </Grid>

                        <Grid
                            Grid.Row="1"
                            RowDefinitions="112,112"
                            ColumnDefinitions="1.28*,0.78*,0.78*"
                            ColumnSpacing="6"
                            RowSpacing="6">

                            <Border
                                Grid.RowSpan="2"
                                CornerRadius="12"
                                ClipToBounds="True">
                                <Grid>
                                    <Image
                                        Source="/Assets/Branding/hero-landscape.png"
                                        Stretch="UniformToFill"
                                        Opacity="0.68" />
                                    <Image
                                        Source="{Binding GalleryPreviewPrimary}"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="1"
                                CornerRadius="12"
                                ClipToBounds="True">
                                <Grid>
                                    <Image
                                        Source="/Assets/Branding/app-background-mist.png"
                                        Stretch="UniformToFill"
                                        Opacity="0.58" />
                                    <Image
                                        Source="{Binding GalleryPreviewSecondary1}"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="2"
                                CornerRadius="12"
                                ClipToBounds="True">
                                <Grid>
                                    <Image
                                        Source="/Assets/Branding/hero-landscape.png"
                                        Stretch="UniformToFill"
                                        Opacity="0.58" />
                                    <Image
                                        Source="{Binding GalleryPreviewSecondary2}"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                CornerRadius="12"
                                ClipToBounds="True">
                                <Grid>
                                    <Image
                                        Source="/Assets/Branding/app-background-mist.png"
                                        Stretch="UniformToFill"
                                        Opacity="0.58" />
                                    <Image
                                        Source="{Binding GalleryPreviewSecondary3}"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="2"
                                CornerRadius="12"
                                ClipToBounds="True">
                                <Grid>
                                    <Image
                                        Source="/Assets/Branding/hero-landscape.png"
                                        Stretch="UniformToFill"
                                        Opacity="0.58" />
                                    <Image
                                        Source="{Binding GalleryPreviewSecondary4}"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Border
                            Grid.Row="2"
                            CornerRadius="12"
                            Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                            Padding="14,12">
                            <Grid ColumnDefinitions="0.9*,0.8*,1.3*" ColumnSpacing="12">
                                <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                                    <PathIcon
                                        Data="{StaticResource ElbwaldIconCamera}"
                                        Width="18"
                                        Height="18"
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding GalleryMediaCountText}" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Medien" Classes="elbwald-muted" FontSize="10" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Column="1" ColumnDefinitions="22,*" ColumnSpacing="10">
                                    <PathIcon
                                        Data="{StaticResource ElbwaldIconFolder}"
                                        Width="18"
                                        Height="18"
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding GalleryFolderCountText}" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Ordner" Classes="elbwald-muted" FontSize="10" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Column="2" ColumnDefinitions="22,*" ColumnSpacing="10">
                                    <PathIcon
                                        Data="{StaticResource ElbwaldIconEye}"
                                        Width="18"
                                        Height="18"
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding GalleryLastUpdatedText}" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Zuletzt aktualisiert" Classes="elbwald-muted" FontSize="10" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button
                                Classes="elbwald-primary-button"
                                Command="{Binding OpenLibraryCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon
                                        Data="{StaticResource ElbwaldIconCamera}"
                                        Width="16"
                                        Height="16"
                                        Foreground="White"
                                        VerticalAlignment="Center" />
                                    <TextBlock Text="Bibliothek öffnen" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button
                                Grid.Column="1"
                                Classes="elbwald-secondary-button"
                                Command="{Binding OpenImportCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="+" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="Neue Medien importieren" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Button
                    Grid.Column="2"
                    Classes="elbwald-home-card"
                    VerticalAlignment="Top"
                    Padding="18"
                    Command="{Binding OpenOrganizeCommand}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
                        <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="14">
                            <Border
                                Width="58"
                                Height="58"
                                CornerRadius="18"
                                Background="{DynamicResource ElbwaldAccentSoftBrush}">
                                <PathIcon
                                    Data="{StaticResource ElbwaldIconFolder}"
                                    Width="28"
                                    Height="28"
                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Bilder ordnen" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Sortieren, Umbenennen und&#x0a;Struktur schaffen." Classes="elbwald-muted" FontSize="11" LineHeight="16" TextWrapping="Wrap" />
                            </StackPanel>

                            <PathIcon
                                Grid.Column="2"
                                Data="{StaticResource ElbwaldIconArrowRight}"
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                VerticalAlignment="Top" />
                        </Grid>

                        <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True" Height="86">
                            <Image Source="/Assets/Branding/home-organize-delta.png" Stretch="UniformToFill" />
                        </Border>

                        <TextBlock
                            Grid.Row="2"
                            Text="{Binding OrganizeHintText}"
                            Classes="elbwald-muted"
                            FontSize="11.5"
                            LineHeight="17"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>

                <Button
                    Grid.Row="1"
                    Classes="elbwald-home-card"
                    VerticalAlignment="Bottom"
                    Padding="18"
                    Command="{Binding OpenMetadataCommand}">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
                        <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="14">
                            <Border
                                Width="58"
                                Height="58"
                                CornerRadius="18"
                                Background="{DynamicResource ElbwaldAccentSoftBrush}">
                                <PathIcon
                                    Data="{StaticResource ElbwaldIconEdit}"
                                    Width="28"
                                    Height="28"
                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Metadaten bearbeiten" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Titel, Tags und Audio-&#x0a;Informationen anpassen." Classes="elbwald-muted" FontSize="11" LineHeight="16" TextWrapping="Wrap" />
                            </StackPanel>

                            <PathIcon
                                Grid.Column="2"
                                Data="{StaticResource ElbwaldIconArrowRight}"
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                VerticalAlignment="Top" />
                        </Grid>

                        <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True" Height="86">
                            <Image Source="/Assets/Branding/home-metadata-fields.png" Stretch="UniformToFill" />
                        </Border>

                        <TextBlock
                            Grid.Row="2"
                            Text="Deine Medien mit den richtigen Informationen bereichern."
                            Classes="elbwald-muted"
                            FontSize="11.5"
                            LineHeight="17"
                            TextWrapping="Wrap" />
                    </Grid>
                </Button>

                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Classes="elbwald-home-card"
                    VerticalAlignment="Bottom"
                    Padding="18"
                    Command="{Binding OpenBackupCommand}">
                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
                        <Grid ColumnDefinitions="62,*,Auto" ColumnSpacing="14">
                            <Border
                                Width="58"
                                Height="58"
                                CornerRadius="18"
                                Background="{DynamicResource ElbwaldAccentSoftBrush}">
                                <PathIcon
                                    Data="{StaticResource ElbwaldIconBackup}"
                                    Width="28"
                                    Height="28"
                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Backup vorbereiten" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Bibliothek schützen und&#x0a;Sicherungen anlegen." Classes="elbwald-muted" FontSize="11" LineHeight="16" TextWrapping="Wrap" />
                            </StackPanel>

                            <PathIcon
                                Grid.Column="2"
                                Data="{StaticResource ElbwaldIconArrowRight}"
                                Width="18"
                                Height="18"
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                VerticalAlignment="Top" />
                        </Grid>

                        <Border Grid.Row="1" CornerRadius="12" ClipToBounds="True" Height="86">
                            <Image Source="/Assets/Branding/home-backup-mountains.png" Stretch="UniformToFill" />
                        </Border>

                        <TextBlock
                            Grid.Row="2"
                            Text="Deine Erinnerungen langfristig sichern – lokal und unter deiner Kontrolle."
                            Classes="elbwald-muted"
                            FontSize="11.5"
                            LineHeight="17"
                            TextWrapping="Wrap" />

                        <Border
                            Grid.Row="3"
                            Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                            BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,8">
                            <Grid ColumnDefinitions="22,*" ColumnSpacing="8">
                                <PathIcon
                                    Data="{StaticResource ElbwaldIconBackup}"
                                    Width="16"
                                    Height="16"
                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock
                                        Text="Backup-Status"
                                        Foreground="{DynamicResource ElbwaldTextBrush}"
                                        FontSize="10.5"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Backup-Funktion in Vorbereitung"
                                        Classes="elbwald-muted"
                                        FontSize="10" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Button>
            </Grid>

            <TextBlock
                Text="Weiter machen"
                Foreground="{DynamicResource ElbwaldTextBrush}"
                FontSize="17"
                FontWeight="SemiBold" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <Button
                    Classes="elbwald-home-card"
                    Padding="16,14"
                    Command="{Binding OpenAnalyzeCommand}">
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource ElbwaldAccentSoftBrush}">
                            <PathIcon Data="{StaticResource ElbwaldIconSearch}" Width="18" Height="18" Foreground="{DynamicResource ElbwaldAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Letzte Analyse fortsetzen" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LastAnalysisPathText}" Classes="elbwald-muted" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding LastAnalysisAgeText}" Classes="elbwald-muted" FontSize="10.5" HorizontalAlignment="Right" />
                            <PathIcon Data="{StaticResource ElbwaldIconArrowRight}" Width="14" Height="14" Foreground="{DynamicResource ElbwaldAccentBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button
                    Grid.Column="1"
                    Classes="elbwald-home-card"
                    Padding="16,14"
                    Command="{Binding OpenImportCommand}">
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource ElbwaldAccentSoftBrush}">
                            <PathIcon Data="{StaticResource ElbwaldIconFolder}" Width="18" Height="18" Foreground="{DynamicResource ElbwaldAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Zuletzt importiert" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LastImportDestinationText}" Classes="elbwald-muted" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LastImportSummaryText}" Classes="elbwald-muted" FontSize="9.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding LastImportAgeText}" Classes="elbwald-muted" FontSize="10.5" HorizontalAlignment="Right" />
                            <PathIcon Data="{StaticResource ElbwaldIconArrowRight}" Width="14" Height="14" Foreground="{DynamicResource ElbwaldAccentBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button
                    Grid.Column="2"
                    Classes="elbwald-home-card"
                    Padding="16,14"
                    Command="{Binding OpenLibraryCommand}">
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource ElbwaldAccentSoftBrush}">
                            <PathIcon Data="{StaticResource ElbwaldIconCamera}" Width="18" Height="18" Foreground="{DynamicResource ElbwaldAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Bibliothek weiter durchsuchen" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="13.5" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LatestLibraryTitle}" Classes="elbwald-muted" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LatestLibrarySubtitle}" Classes="elbwald-muted" FontSize="9.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding LatestLibraryAgeText}" Classes="elbwald-muted" FontSize="10.5" HorizontalAlignment="Right" />
                            <PathIcon Data="{StaticResource ElbwaldIconArrowRight}" Width="14" Height="14" Foreground="{DynamicResource ElbwaldAccentBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <Border
                IsVisible="{Binding IsRecoveryPanelVisible}"
                Classes="elbwald-card"
                Padding="16">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock
                            Text="Dateisicherheit benötigt Aufmerksamkeit"
                            Foreground="{DynamicResource ElbwaldTextBrush}"
                            FontSize="15"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding RecoveryStatusMessage}"
                            Classes="elbwald-muted"
                            FontSize="11"
                            LineHeight="17"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Classes="elbwald-secondary-button"
                        Command="{Binding RefreshRecoveryCommand}"
                        VerticalAlignment="Center"
                        Content="Erneut prüfen" />

                    <Button
                        Grid.Column="2"
                        Classes="elbwald-secondary-button"
                        Command="{Binding OpenLibraryHealthCommand}"
                        VerticalAlignment="Center"
                        Content="Bibliotheksstatus" />

                    <Button
                        Grid.Column="3"
                        Classes="elbwald-primary-button"
                        Command="{Binding RunSafeRecoveryCommand}"
                        IsVisible="{Binding CanRunAutomaticRecovery}"
                        VerticalAlignment="Center"
                        Content="Sichere Recovery" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <Border
                    Classes="elbwald-card"
                    Padding="18,16"
                    Background="{DynamicResource ElbwaldSurfaceQuietBrush}">
                    <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                        <PathIcon
                            Data="{StaticResource ElbwaldIconTree}"
                            Width="24"
                            Height="24"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Offline first" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Analyse und Verarbeitung laufen lokal auf deinem Gerät." Classes="elbwald-muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Classes="elbwald-card"
                    Padding="18,16"
                    Background="{DynamicResource ElbwaldSurfaceQuietBrush}">
                    <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                        <PathIcon
                            Data="{StaticResource ElbwaldIconSettings}"
                            Width="24"
                            Height="24"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Keine Cloud-Pflicht" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Deine Medien bleiben unter deiner Kontrolle und verlassen dein Gerät nicht." Classes="elbwald-muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Classes="elbwald-card"
                    Padding="18,16"
                    Background="{DynamicResource ElbwaldSurfaceQuietBrush}">
                    <Grid ColumnDefinitions="36,*" ColumnSpacing="12">
                        <PathIcon
                            Data="{StaticResource ElbwaldIconBackup}"
                            Width="24"
                            Height="24"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Safety first" Foreground="{DynamicResource ElbwaldTextBrush}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Dateiverändernde Aktionen bleiben Vorschau-, Recovery- und Sicherheitsregeln unterworfen." Classes="elbwald-muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
