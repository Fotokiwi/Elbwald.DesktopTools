<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
    x:Class="Elbwald.DesktopTools.App.Views.HomeView"
    x:DataType="vm:HomeViewModel">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel
            Margin="46,40,46,46"
            MaxWidth="1120"
            Spacing="22">

            <Grid MinHeight="230">
                <StackPanel
                    MaxWidth="540"
                    Spacing="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">

                    <TextBlock
                        Text="Willkommen"
                        Classes="elbwald-title" />

                    <TextBlock
                        Text="Was möchtest du mit deinen Medien machen?"
                        Foreground="{DynamicResource ElbwaldTextBrush}"
                        FontSize="21"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="Analysiere, organisiere, bearbeite und sichere deine Medien lokal, übersichtlich und nachvollziehbar."
                        Classes="elbwald-muted"
                        FontSize="14"
                        LineHeight="21"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="Deine Medien in guten Händen."
                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                        FontSize="12"
                        FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <Grid
                ColumnDefinitions="1.35*,0.65*"
                ColumnSpacing="16">

                <Border
                    Classes="elbwald-card"
                    Padding="24"
                    Background="{DynamicResource ElbwaldAccentSoftBrush}">

                    <Grid
                        ColumnDefinitions="72,*"
                        ColumnSpacing="18">

                        <Border
                            Width="66"
                            Height="66"
                            CornerRadius="18"
                            Background="{DynamicResource ElbwaldAccentBrush}">
                            <PathIcon
                                Data="{StaticResource ElbwaldIconSearch}"
                                Width="31"
                                Height="31"
                                Foreground="White"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Spacing="8">

                            <TextBlock
                                Text="Medien analysieren"
                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                FontSize="23"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Ordner auswählen und Bibliothek read-only auf Formate, Metadaten und Auffälligkeiten prüfen."
                                Classes="elbwald-muted"
                                FontSize="13"
                                LineHeight="19"
                                TextWrapping="Wrap" />

                            <Button
                                Classes="elbwald-primary-button"
                                Command="{Binding OpenAnalyzeCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,5,0,0"
                                Content="Analyse öffnen" />

                            <TextBlock
                                Text="✓ Nur Analyse · keine Dateien werden verändert"
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                FontSize="11"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Classes="elbwald-card"
                    Padding="20">

                    <StackPanel Spacing="10">
                        <TextBlock
                            Text="Dateisicherheit"
                            Classes="elbwald-section-title" />

                        <TextBlock
                            Text="{Binding RecoveryStatusTitle}"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontSize="17"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{Binding RecoveryStatusMessage}"
                            Classes="elbwald-muted"
                            FontSize="12"
                            LineHeight="18"
                            TextWrapping="Wrap" />

                        <Border
                            Background="{DynamicResource ElbwaldAccentSoftBrush}"
                            CornerRadius="9"
                            Padding="10">
                            <TextBlock
                                Text="Bei Unsicherheit wird nichts gelöscht und nichts überschrieben."
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                FontSize="10"
                                TextWrapping="Wrap" />
                        </Border>

                        <Button
                            Classes="elbwald-secondary-button"
                            Command="{Binding OpenLibraryHealthCommand}"
                            HorizontalAlignment="Left"
                            Content="Bibliotheksstatus" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock
                Text="Schnellaktionen"
                Classes="elbwald-section-title" />

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="12">

                <Button
                    Classes="elbwald-tool-card"
                    Command="{Binding OpenOrganizeCommand}">
                    <StackPanel Spacing="9">
                        <PathIcon
                            Data="{StaticResource ElbwaldIconFolder}"
                            Width="25"
                            Height="25"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            HorizontalAlignment="Left" />
                        <TextBlock
                            Text="Organisieren"
                            FontSize="17"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Importieren, sortieren und umbenennen."
                            Classes="elbwald-muted"
                            FontSize="11"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="1"
                    Classes="elbwald-tool-card"
                    Command="{Binding OpenEditCommand}">
                    <StackPanel Spacing="9">
                        <PathIcon
                            Data="{StaticResource ElbwaldIconEdit}"
                            Width="25"
                            Height="25"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            HorizontalAlignment="Left" />
                        <TextBlock
                            Text="Bearbeiten"
                            FontSize="17"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Bilder, Audio und später Video bearbeiten."
                            Classes="elbwald-muted"
                            FontSize="11"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>

                <Button
                    Grid.Column="2"
                    Classes="elbwald-tool-card"
                    Command="{Binding OpenBackupCommand}">
                    <StackPanel Spacing="9">
                        <PathIcon
                            Data="{StaticResource ElbwaldIconBackup}"
                            Width="25"
                            Height="25"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            HorizontalAlignment="Left" />
                        <TextBlock
                            Text="Sichern"
                            FontSize="17"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Redundante, überprüfbare Sicherungen vorbereiten."
                            Classes="elbwald-muted"
                            FontSize="11"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border IsVisible="{Binding IsRecoveryPanelVisible}"
                    Classes="elbwald-card"
                    Padding="22">
                <StackPanel Spacing="18">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="18">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Recovery &amp; Dateisicherheit"
                                       Classes="elbwald-section-title" />

                            <TextBlock Text="Solange hier ein ungeklärter Zustand besteht, bleiben alle dateiverändernden Operationen im Core gesperrt."
                                       Classes="elbwald-muted"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="elbwald-secondary-button"
                                Command="{Binding RefreshRecoveryCommand}"
                                VerticalAlignment="Center"
                                Content="Erneut prüfen" />
                    </Grid>

                    <Border IsVisible="{Binding HasJournalCorruption}"
                            Background="{DynamicResource ElbwaldDangerSoftBrush}"
                            CornerRadius="12"
                            Padding="14">
                        <Grid ColumnDefinitions="28,*"
                              ColumnSpacing="10">
                            <PathIcon Data="{StaticResource ElbwaldIconWarning}"
                                      Width="20"
                                      Height="20"
                                      Foreground="{DynamicResource ElbwaldDangerBrush}"
                                      VerticalAlignment="Top" />

                            <StackPanel Grid.Column="1"
                                        Spacing="3">
                                <TextBlock Text="Automatische Recovery gesperrt"
                                           Foreground="{DynamicResource ElbwaldDangerBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Das Journal enthält beschädigte Zeilen. Normale Recovery bleibt deshalb gesperrt. Die Journal-Reparatur darf ausschließlich einen eindeutig abgebrochenen letzten Schreibvorgang entfernen und legt vorher ein vollständiges Backup an."
                                           Classes="elbwald-muted"
                                           FontSize="12"
                                           LineHeight="18"
                                           TextWrapping="Wrap" />

                                <Button Classes="elbwald-secondary-button"
                                        Command="{Binding RepairJournalCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0"
                                        Content="Journal-Reparatur sicher prüfen" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel IsVisible="{Binding HasRecoveryCandidates}"
                                Spacing="10">
                        <TextBlock Text="Offene Vorgänge"
                                   Foreground="{DynamicResource ElbwaldTextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />

                        <ItemsControl ItemsSource="{Binding RecoveryCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecoveryCandidateViewModel">
                                    <Border Classes="elbwald-recovery-item"
                                            Margin="0,0,0,8"
                                            Padding="14">
                                        <Grid RowDefinitions="Auto,Auto,Auto"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="14"
                                              RowSpacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding OperationLabel}"
                                                           Foreground="{DynamicResource ElbwaldTextBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StateLabel}"
                                                           Classes="elbwald-muted"
                                                           FontSize="11" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource ElbwaldAccentSoftBrush}"
                                                    CornerRadius="8"
                                                    Padding="8,4"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding TransactionShortId}"
                                                           Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>

                                            <Grid Grid.Row="1"
                                                  Grid.ColumnSpan="2"
                                                  ColumnDefinitions="72,*"
                                                  RowDefinitions="Auto,Auto"
                                                  RowSpacing="5">
                                                <TextBlock Text="Quelle"
                                                           Classes="elbwald-muted"
                                                           FontSize="11" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SourcePath}"
                                                           Foreground="{DynamicResource ElbwaldTextBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />

                                                <TextBlock Grid.Row="1"
                                                           Text="Ziel"
                                                           Classes="elbwald-muted"
                                                           FontSize="11" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="{Binding DestinationPath}"
                                                           Foreground="{DynamicResource ElbwaldTextBrush}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>

                                            <WrapPanel Grid.Row="2"
                                                       Grid.ColumnSpan="2">
                                                <Border Background="{DynamicResource ElbwaldAccentSoftBrush}"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding SourceStateLabel}"
                                                               FontSize="10" />
                                                </Border>

                                                <Border Background="{DynamicResource ElbwaldAccentSoftBrush}"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        Margin="0,0,8,8">
                                                    <TextBlock Text="{Binding DestinationStateLabel}"
                                                               FontSize="10" />
                                                </Border>

                                                <Border Background="{DynamicResource ElbwaldWarmCardBrush}"
                                                        CornerRadius="8"
                                                        Padding="8,4"
                                                        Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding RecoveryStateLabel}"
                                                               FontSize="10" />
                                                </Border>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="18">
                        <TextBlock Text="Die sichere Recovery prüft jeden Vorgang erneut. Vorhandene Dateien werden nicht überschrieben; zweideutige Fälle bleiben zur manuellen Prüfung offen."
                                   Classes="elbwald-muted"
                                   FontSize="11"
                                   LineHeight="17"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Classes="elbwald-primary-button"
                                Command="{Binding RunSafeRecoveryCommand}"
                                IsVisible="{Binding HasRecoveryCandidates}"
                                VerticalAlignment="Center"
                                Content="Sichere Recovery starten" />
                    </Grid>

                    <ProgressBar IsVisible="{Binding IsRecoveryBusy}"
                                 IsIndeterminate="True"
                                 Height="4" />

                    <Border IsVisible="{Binding IsRecoveryActionMessageVisible}"
                            Background="{DynamicResource ElbwaldAccentSoftBrush}"
                            CornerRadius="10"
                            Padding="12">
                        <TextBlock Text="{Binding RecoveryActionMessage}"
                                   Foreground="{DynamicResource ElbwaldTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel IsVisible="{Binding HasRecoveryResults}"
                                Spacing="10">
                        <TextBlock Text="Letztes Recovery-Ergebnis"
                                   Foreground="{DynamicResource ElbwaldTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <ItemsControl ItemsSource="{Binding RecoveryResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecoveryResultViewModel">
                                    <Border Classes="elbwald-recovery-item"
                                            Margin="0,0,0,6"
                                            Padding="12">
                                        <Grid ColumnDefinitions="24,*"
                                              ColumnSpacing="10">
                                            <Grid Width="20"
                                                  Height="20">
                                                <PathIcon IsVisible="{Binding IsSuccessful}"
                                                          Data="{StaticResource ElbwaldIconCheck}"
                                                          Width="18"
                                                          Height="18"
                                                          Foreground="{DynamicResource ElbwaldAccentBrush}" />
                                                <PathIcon IsVisible="{Binding RequiresManualAction}"
                                                          Data="{StaticResource ElbwaldIconWarning}"
                                                          Width="18"
                                                          Height="18"
                                                          Foreground="{DynamicResource ElbwaldWarningBrush}" />
                                                <PathIcon IsVisible="{Binding IsFailed}"
                                                          Data="{StaticResource ElbwaldIconWarning}"
                                                          Width="18"
                                                          Height="18"
                                                          Foreground="{DynamicResource ElbwaldDangerBrush}" />
                                            </Grid>

                                            <StackPanel Grid.Column="1"
                                                        Spacing="3">
                                                <TextBlock Foreground="{DynamicResource ElbwaldTextBrush}"
                                                           FontWeight="SemiBold">
                                                    <Run Text="{Binding OutcomeLabel}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding TransactionShortId}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Message}"
                                                           Classes="elbwald-muted"
                                                           FontSize="11"
                                                           LineHeight="17"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding HasModuleLoadFailures}"
                    Classes="elbwald-card"
                    Padding="18">
                <StackPanel Spacing="10">
                    <TextBlock Text="Einige Add-ons konnten nicht geladen werden"
                               Foreground="#A04A35"
                               FontWeight="SemiBold" />

                    <ItemsControl ItemsSource="{Binding FailedModules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModuleLoadFailureViewModel">
                                <StackPanel Margin="0,4"
                                            Spacing="2">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Message}"
                                               Classes="elbwald-muted"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border
                Classes="elbwald-soft-card"
                Padding="18">
                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="18">
                    <StackPanel Spacing="3">
                        <TextBlock
                            Text="Offline first"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Analyse und Verarbeitung laufen lokal auf deinem Gerät."
                            Classes="elbwald-muted"
                            FontSize="10"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            Text="Keine Cloud-Pflicht"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Deine Medien bleiben unter deiner Kontrolle."
                            Classes="elbwald-muted"
                            FontSize="10"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock
                            Text="Safety first"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="Dateiverändernde Aktionen bleiben Vorschau-, Recovery- und Sicherheitsregeln unterworfen."
                            Classes="elbwald-muted"
                            FontSize="10"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
