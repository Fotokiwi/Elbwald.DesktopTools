<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
    x:Class="Elbwald.DesktopTools.App.Views.RenameView"
    x:DataType="vm:RenameViewModel">

    <UserControl.Styles>
        <Style Selector="Border.elbwald-card">
            <Setter Property="Background" Value="{DynamicResource ElbwaldCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElbwaldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Border.elbwald-soft-card">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="TextBlock.elbwald-title">
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldTextBrush}" />
            <Setter Property="FontSize" Value="38" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.elbwald-section-title">
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldTextBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.elbwald-muted">
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldMutedTextBrush}" />
        </Style>
        <Style Selector="Button.elbwald-primary-button">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.elbwald-primary-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.elbwald-secondary-button">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElbwaldAccentSoftStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.elbwald-chip">
            <Setter Property="Background" Value="{DynamicResource ElbwaldPageBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElbwaldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,7,7" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,26,34,42" MaxWidth="1420" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="Umbenennen" Classes="elbwald-title" />
                <TextBlock
                    Text="Medien nachvollziehbar und sicher umbenennen – mit Regelvorschau vor jeder Änderung."
                    Classes="elbwald-muted"
                    FontSize="13" />
            </StackPanel>

            <!-- Workflow -->
            <Grid ColumnDefinitions="1.1*,1.9*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="elbwald-card" Padding="17">
                    <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ElbwaldAccentSoftBrush}">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ElbwaldAccentBrush}" FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Quelle" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding SourcePath}" Classes="elbwald-muted" FontSize="10" TextTrimming="CharacterEllipsis" MaxLines="2" />
                            <CheckBox Content="Unterordner einbeziehen" IsChecked="{Binding IncludeSubdirectories}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="elbwald-secondary-button" Content="Ändern" Command="{Binding ChooseFolderCommand}" VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="elbwald-card" Padding="17">
                    <Grid ColumnDefinitions="38,*" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ElbwaldAccentSoftBrush}">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ElbwaldAccentBrush}" FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Namensregel" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="Freier Text + Platzhalter. Die Dateiendung bleibt automatisch erhalten." Classes="elbwald-muted" FontSize="10" />
                            <TextBlock Text="{Binding Pattern}" Foreground="{DynamicResource ElbwaldAccentBrush}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Rule editor -->
            <Border Classes="elbwald-card" Padding="18">
                <StackPanel Spacing="13">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Namensregel" Classes="elbwald-section-title" />
                            <TextBlock Text="Freier Text und Platzhalter lassen sich beliebig kombinieren. Die Dateiendung des Mediums bleibt automatisch erhalten." Classes="elbwald-muted" FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Gemeinsame Rule Engine mit Sortieren" Classes="elbwald-muted" FontSize="10" VerticalAlignment="Center" />
                    </Grid>

                    <TextBox
                        Text="{Binding Pattern, Mode=TwoWay}"
                        IsReadOnly="{Binding IsBusy}"
                        FontSize="15"
                        Padding="12,10"
                        Watermark="{}z. B. Urlaub_{date:yyyy-MM-dd}_{camera}_{seq:000}" />

                    <WrapPanel>
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{year}" Content="Jahr" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{month}" Content="Monat" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{day}" Content="Tag" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{date:yyyy-MM-dd}" Content="Datum" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{time:HHmmss}" Content="Zeit" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{camera}" Content="Kamera" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{make}" Content="Hersteller" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{model}" Content="Modell" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{title}" Content="Titel" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{description}" Content="Beschreibung" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{type}" Content="Medientyp" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{folder}" Content="Quellordner" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{original}" Content="Originalname" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{ext}" Content="Erweiterung" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{width}" Content="Breite" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{height}" Content="Höhe" />
                        <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{seq:000}" Content="Sequenz" />
                    </WrapPanel>

                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="9">
                        <Button Grid.Column="0" Classes="elbwald-secondary-button" Content="Archiv" Command="{Binding UseArchivePresetCommand}" />
                        <Button Grid.Column="1" Classes="elbwald-secondary-button" Content="Lesbar" Command="{Binding UseReadablePresetCommand}" />
                        <Button Grid.Column="2" Classes="elbwald-secondary-button" Content="Original + Datum" Command="{Binding UseOriginalPresetCommand}" />
                        <TextBlock Grid.Column="3" Text="Datum: Elbwald-Override → EXIF → Dateisystem" Classes="elbwald-muted" FontSize="10" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>

                    <Expander Header="Formatbeispiele">
                        <Grid Margin="8,8,0,0" ColumnDefinitions="*,*" ColumnSpacing="18">
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="{}Datum/Zeit: {date:FORMAT} · {time:FORMAT}" TextWrapping="Wrap" />
                                <TextBlock Text="{}Sequenz: {seq:000} · {seq:0000}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{}Beispiel: Urlaub_{date:yyyy-MM-dd}_{camera}_{seq:000}" TextWrapping="Wrap" />
                                <TextBlock Text="Leere Metadaten werden von der Rule Engine mit sicheren Fallbacks behandelt." Classes="elbwald-muted" FontSize="10" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Action/status -->
            <Border Classes="elbwald-soft-card" Padding="12">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                    <Button Grid.Column="0" Classes="elbwald-primary-button" Content="Vorschau aktualisieren" Command="{Binding CreatePreviewCommand}" />
                    <Button Grid.Column="1" Classes="elbwald-secondary-button" Content="Umbenennen" Command="{Binding ExecuteCommand}" IsEnabled="{Binding CanRun}" />
                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsVisible="{Binding IsBusy}" Height="4" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="Keine Überschreibungen" Foreground="{DynamicResource ElbwaldAccentBrush}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Preview -->
            <Border Classes="elbwald-card" IsVisible="{Binding HasPreview}" Padding="18">
                <StackPanel Spacing="13">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Vorschau" Classes="elbwald-section-title" />
                            <TextBlock Text="RAW/JPEG-Gruppen behalten denselben neuen Stamm; vorhandene .xmp-Begleitdateien werden gemeinsam geplant." Classes="elbwald-muted" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Alt → Neu" Classes="elbwald-muted" FontSize="10" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Grid.Column="0" Classes="elbwald-soft-card" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Bereit" Classes="elbwald-muted" FontSize="9" />
                                <TextBlock Text="{Binding ReadyCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ElbwaldAccentBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="elbwald-soft-card" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Unverändert" Classes="elbwald-muted" FontSize="9" />
                                <TextBlock Text="{Binding UnchangedCount}" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="elbwald-soft-card" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Konflikte" Classes="elbwald-muted" FontSize="9" />
                                <TextBlock Text="{Binding ConflictCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ElbwaldDangerBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{DynamicResource ElbwaldPageBrush}" BorderBrush="{DynamicResource ElbwaldBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="6">
                        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RenamePlanItemViewModel">
                                        <Grid ColumnDefinitions="1.1*,38,1.25*,110,105" ColumnSpacing="10" Margin="7,8">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Kind}" Classes="elbwald-muted" FontSize="9" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="{DynamicResource ElbwaldAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Message}" Classes="elbwald-muted" FontSize="9" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding DateSource}" Classes="elbwald-muted" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Status}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Result -->
            <Border Classes="elbwald-card" IsVisible="{Binding HasResult}" Padding="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Abschluss" Classes="elbwald-section-title" />
                    <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Safety -->
            <Border Classes="elbwald-card" Padding="18">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Sicherer Vorgang" Classes="elbwald-section-title" />
                            <TextBlock Text="Vorschau erforderlich · keine Überschreibungen · SHA-256-Recheck · Recovery vor jedem Move · Benutzer-Historie" Classes="elbwald-muted" FontSize="10" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Recovery aktiv" Foreground="{DynamicResource ElbwaldAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>

                    <Expander Header="Sicherheitsdetails">
                        <TextBlock Margin="8" Classes="elbwald-muted" FontSize="10" TextWrapping="Wrap"
                                   Text="• Erst Vorschau, dann Ausführung.&#10;• Quellen werden unmittelbar vor dem Rename erneut über Größe, Zeitstempel und SHA-256 geprüft.&#10;• Existierende Ziele, doppelte Ziele und Rename-Ketten werden blockiert.&#10;• Vor jedem Move erstellt die Dateioperations-Engine eine persistente Recovery-Sicherung und journalisiert den Vorgang.&#10;• Nach Beginn der destruktiven Phase gibt es bewusst keinen Benutzerabbruch.&#10;• Erfolgreiche Umbenennungen werden zusätzlich in der Benutzer-Historie protokolliert.&#10;• Der Medienindex wird nicht heimlich umgeschrieben; beim nächsten Indexlauf wird die Datei anhand ihrer Content-ID wiedergefunden." />
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
