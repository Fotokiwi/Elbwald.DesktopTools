<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
    x:Class="Elbwald.DesktopTools.App.Views.RenameView"
    x:DataType="vm:RenameViewModel">

    <UserControl.Styles>
        <Style Selector="Border.elbwald-card">
            <Setter Property="Background" Value="{DynamicResource ElbwaldCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElbwaldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="Border.elbwald-soft-card">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style Selector="TextBlock.elbwald-title">
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldTextBrush}" />
            <Setter Property="FontSize" Value="38" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.elbwald-section-title">
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldTextBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.elbwald-muted">
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldMutedTextBrush}" />
        </Style>
        <Style Selector="Button.elbwald-primary-button">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.elbwald-primary-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.elbwald-secondary-button">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElbwaldAccentSoftStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.elbwald-chip">
            <Setter Property="Background" Value="{DynamicResource ElbwaldPageBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElbwaldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,7,7" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,26,34,42" MaxWidth="1420" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="Umbenennen" Classes="elbwald-title" />
                <TextBlock
                    Text="Gib vielen Dateien einheitliche, verständliche Namen. Eine Vorschau zeigt dir jede Änderung, bevor etwas passiert."
                    Classes="elbwald-muted"
                    FontSize="13"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- Geführter Einstieg -->
            <Grid ColumnDefinitions="1.1*,1.9*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="elbwald-card" Padding="17">
                    <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ElbwaldAccentSoftBrush}">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ElbwaldAccentBrush}" FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Welche Dateien?" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding SourceContextText}" Foreground="{DynamicResource ElbwaldAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SourcePath}" Classes="elbwald-muted" FontSize="10" TextTrimming="CharacterEllipsis" MaxLines="2" />
                            <CheckBox Content="Unterordner einbeziehen" IsChecked="{Binding IncludeSubdirectories}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="elbwald-secondary-button" Content="Andere Quelle" Command="{Binding ChooseFolderCommand}" VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="elbwald-card" Padding="17">
                    <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ElbwaldAccentSoftBrush}">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ElbwaldAccentBrush}" FontWeight="Bold" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Wie sollen die Dateien heißen?" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding RuleName}" Foreground="{DynamicResource ElbwaldAccentBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="Beispiel:" Classes="elbwald-muted" FontSize="9.5" />
                            <TextBlock Text="{Binding ExampleFileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Endung bleibt erhalten" Classes="elbwald-muted" FontSize="10" VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Namensstil -->
            <Border Classes="elbwald-card" Padding="18">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Namensstil auswählen" Classes="elbwald-section-title" />
                        <TextBlock
                            Text="Für die meisten Sammlungen reicht eine Vorlage. Du kannst sie später jederzeit anpassen."
                            Classes="elbwald-muted"
                            FontSize="11"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <WrapPanel>
                        <Button Classes="elbwald-secondary-button" Margin="0,0,8,8" Content="Datum + Uhrzeit" Command="{Binding UseReadablePresetCommand}" ToolTip.Tip="Gut für Fotos und Videos: 2026-10-11_14-35-22.jpg. Eine Nummer wird nur ergänzt, wenn derselbe Name sonst doppelt wäre." />
                        <Button Classes="elbwald-secondary-button" Margin="0,0,8,8" Content="Datum + Originalname" Command="{Binding UseOriginalPresetCommand}" ToolTip.Tip="Behält den bisherigen Namen und ergänzt vorne das Aufnahmedatum." />
                        <Button Classes="elbwald-secondary-button" Margin="0,0,8,8" Content="Datum + Kamera" Command="{Binding UseCameraPresetCommand}" ToolTip.Tip="Praktisch bei mehreren Kameras oder Geräten." />
                        <Button Classes="elbwald-secondary-button" Margin="0,0,8,8" Content="Datum + Titel" Command="{Binding UseTitlePresetCommand}" ToolTip.Tip="Gut für gepflegte Sammlungen mit Titeln oder Beschreibungen." />
                        <Button Classes="elbwald-secondary-button" Margin="0,0,8,8" Content="Archiv · Datum + Nummer" Command="{Binding UseArchivePresetCommand}" ToolTip.Tip="Kompakter Archivname mit fester Nummer: 20261011_143522_001.jpg" />
                    </WrapPanel>

                    <Border Classes="elbwald-soft-card" Padding="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <TextBlock Text="Beispiel" Foreground="{DynamicResource ElbwaldAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ExampleFileName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Expander Header="Eigene Namensregel anpassen">
                        <StackPanel Margin="4,10,4,0" Spacing="12">
                            <TextBlock
                                Text="Fortgeschritten: Du kannst Text und Platzhalter frei kombinieren. Die Dateiendung wird automatisch beibehalten."
                                Classes="elbwald-muted"
                                FontSize="10.5"
                                TextWrapping="Wrap" />

                            <TextBox
                                Text="{Binding Pattern, Mode=TwoWay}"
                                IsReadOnly="{Binding IsBusy}"
                                FontSize="14"
                                Padding="12,10"
                                PlaceholderText="{}z. B. Urlaub_{date:yyyy-MM-dd}_{camera}_{seq:000}" />

                            <WrapPanel>
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{year}" Content="Jahr" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{month}" Content="Monat" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{day}" Content="Tag" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{date:yyyy-MM-dd}" Content="Datum" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{time:HHmmss}" Content="Zeit" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{camera}" Content="Kamera" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{make}" Content="Hersteller" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{model}" Content="Modell" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{title}" Content="Titel" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{description}" Content="Beschreibung" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{type}" Content="Medientyp" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{folder}" Content="Quellordner" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{original}" Content="Originalname" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{width}" Content="Breite" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{height}" Content="Höhe" />
                                <Button Classes="elbwald-chip" Command="{Binding InsertTokenCommand}" CommandParameter="{}{seq:000}" Content="Sequenz" />
                            </WrapPanel>

                            <TextBlock
                                Text="Datum wird aus den vorhandenen Medieninformationen ermittelt. Fehlende Angaben erhalten sichere Fallbacks."
                                Classes="elbwald-muted"
                                FontSize="10"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Aktionen -->
            <Border Classes="elbwald-soft-card" Padding="12">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                    <Button
                        Grid.Column="0"
                        Classes="elbwald-primary-button"
                        Content="{Binding PreviewActionText}"
                        Command="{Binding CreatePreviewCommand}"
                        IsVisible="{Binding NeedsPreview}" />
                    <Button
                        Grid.Column="0"
                        Classes="elbwald-secondary-button"
                        Content="Vorschau aktualisieren"
                        Command="{Binding CreatePreviewCommand}"
                        IsVisible="{Binding HasPreview}" />
                    <Button
                        Grid.Column="1"
                        Classes="elbwald-primary-button"
                        Content="{Binding ExecuteActionText}"
                        Command="{Binding ExecuteCommand}"
                        IsEnabled="{Binding CanRun}"
                        IsVisible="{Binding HasPreview}" />
                    <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsVisible="{Binding IsBusy}" Height="4" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="Keine Dateien werden überschrieben" Foreground="{DynamicResource ElbwaldAccentBrush}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Vorschau -->
            <Border Classes="elbwald-card" IsVisible="{Binding HasPreview}" Padding="18">
                <StackPanel Spacing="13">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Vorschau" Classes="elbwald-section-title" />
                            <TextBlock
                                Text="Links siehst du den bisherigen Namen, rechts den neuen. Begleitdateien wie XMP werden automatisch passend mitgeführt."
                                Classes="elbwald-muted"
                                FontSize="10.5"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Alt → Neu" Classes="elbwald-muted" FontSize="10" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Border Grid.Column="0" Classes="elbwald-soft-card" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Wird umbenannt" Classes="elbwald-muted" FontSize="9" />
                                <TextBlock Text="{Binding ReadyCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ElbwaldAccentBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="elbwald-soft-card" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Bleibt unverändert" Classes="elbwald-muted" FontSize="9" />
                                <TextBlock Text="{Binding UnchangedCount}" FontSize="20" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="elbwald-soft-card" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Muss geprüft werden" Classes="elbwald-muted" FontSize="9" />
                                <TextBlock Text="{Binding ConflictCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ElbwaldDangerBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="{DynamicResource ElbwaldPageBrush}" BorderBrush="{DynamicResource ElbwaldBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="6">
                        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RenamePlanItemViewModel">
                                        <Grid ColumnDefinitions="1.05*,38,1.25*,120,125" ColumnSpacing="10" Margin="7,8">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Kind}" Classes="elbwald-muted" FontSize="9" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="{DynamicResource ElbwaldAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" Spacing="2">
                                                <TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Message}" Classes="elbwald-muted" FontSize="9" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding FriendlyDateSource}" Classes="elbwald-muted" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding FriendlyStatus}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Ergebnis -->
            <Border Classes="elbwald-card" IsVisible="{Binding HasResult}" Padding="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="Umbenennen abgeschlossen" Classes="elbwald-section-title" />
                    <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Sicherheit -->
            <Border Classes="elbwald-card" Padding="18">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Sicher umbenennen" Classes="elbwald-section-title" />
                            <TextBlock
                                Text="Vor dem Umbenennen wird jede Datei noch einmal geprüft. Vorhandene Dateien werden nicht überschrieben und der Vorgang kann bei Problemen wiederhergestellt werden."
                                Classes="elbwald-muted"
                                FontSize="10.5"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Recovery aktiv" Foreground="{DynamicResource ElbwaldAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>

                    <Expander Header="Technische Sicherheitsdetails anzeigen">
                        <TextBlock Margin="8" Classes="elbwald-muted" FontSize="10" TextWrapping="Wrap"
                                   Text="• Erst Vorschau, dann Ausführung.&#10;• Quellen werden unmittelbar vor dem Umbenennen erneut über Größe, Zeitstempel und SHA-256 geprüft.&#10;• Existierende Ziele, doppelte Ziele und Umbenennungs-Ketten werden blockiert.&#10;• Vor jeder Änderung erstellt die Dateioperations-Engine eine persistente Recovery-Sicherung und journalisiert den Vorgang.&#10;• Erfolgreiche Umbenennungen werden zusätzlich in der Benutzer-Historie protokolliert.&#10;• Beim nächsten Indexlauf wird die Datei anhand ihrer Content-ID wiedergefunden." />
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
