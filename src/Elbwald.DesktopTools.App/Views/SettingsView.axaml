<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
    x:Class="Elbwald.DesktopTools.App.Views.SettingsView"
    x:DataType="vm:SettingsViewModel">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel
            Margin="46,40,46,46"
            MaxWidth="1080"
            Spacing="22">

            <StackPanel Spacing="7">
                <TextBlock
                    Text="Einstellungen"
                    Classes="elbwald-title" />

                <TextBlock
                    Text="Cache, Performance und lokale App-Daten verwalten."
                    Classes="elbwald-muted"
                    FontSize="14"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Classes="elbwald-card"
                Padding="20">

                <StackPanel Spacing="14">
                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="14">

                        <StackPanel Spacing="3">
                            <TextBlock
                                Text="Cache &amp; Performance"
                                Classes="elbwald-section-title" />

                            <TextBlock
                                Text="Beide Medien-Caches sind vollständig wiederherstellbar."
                                Classes="elbwald-muted"
                                FontSize="11" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Classes="elbwald-secondary-button"
                            Command="{Binding RefreshCacheCommand}"
                            Content="Aktualisieren" />
                    </Grid>

                    <Grid
                        ColumnDefinitions="*,*,220"
                        ColumnSpacing="12">

                        <Border
                            Background="{DynamicResource ElbwaldPageBrush}"
                            BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="15">

                            <StackPanel Spacing="7">
                                <TextBlock
                                    Text="SQLite Analyse-Cache"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Text="{Binding AnalysisCacheSummary}"
                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Text="{Binding AnalysisCacheLocation}"
                                    Classes="elbwald-muted"
                                    FontSize="9"
                                    TextTrimming="CharacterEllipsis" />

                                <Button
                                    Classes="elbwald-secondary-button"
                                    Command="{Binding ClearAnalysisCacheCommand}"
                                    Content="Analyse-Cache leeren"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="1"
                            Background="{DynamicResource ElbwaldPageBrush}"
                            BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="15">

                            <StackPanel Spacing="7">
                                <TextBlock
                                    Text="Thumbnail-Cache"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Text="{Binding ThumbnailCacheSummary}"
                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Text="{Binding ThumbnailCacheLocation}"
                                    Classes="elbwald-muted"
                                    FontSize="9"
                                    TextTrimming="CharacterEllipsis" />

                                <Button
                                    Classes="elbwald-secondary-button"
                                    Command="{Binding ClearThumbnailCacheCommand}"
                                    Content="Thumbnails leeren"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Column="2"
                            Background="{DynamicResource ElbwaldAccentSoftBrush}"
                            CornerRadius="12"
                            Padding="15">

                            <StackPanel Spacing="6">
                                <TextBlock
                                    Text="Gesamt"
                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Text="{Binding TotalCacheSize}"
                                    Foreground="{DynamicResource ElbwaldTextBrush}"
                                    FontSize="24"
                                    FontWeight="SemiBold" />

                                <Button
                                    Classes="elbwald-primary-button"
                                    Command="{Binding ClearAllCachesCommand}"
                                    Content="Alle Caches leeren"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Background="{DynamicResource ElbwaldPageBrush}"
                        BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <TextBlock
                                Text="{Binding OperationStatus}"
                                Classes="elbwald-muted"
                                FontSize="11"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding OperationDuration}"
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                FontSize="11"
                                FontWeight="SemiBold" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Border
                    Classes="elbwald-card"
                    Padding="20">

                    <StackPanel Spacing="9">
                        <TextBlock
                            Text="Performance"
                            Classes="elbwald-section-title" />

                        <TextBlock
                            Text="{Binding PerformanceProfile}"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{Binding PerformanceDetails}"
                            Classes="elbwald-muted"
                            FontSize="11"
                            LineHeight="18"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Text="Konfigurierbare Grenzwerte folgen später. Aktuell nutzt Elbwald Digital bewusst konservative Defaults für große Bibliotheken."
                            Classes="elbwald-muted"
                            FontSize="10"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Classes="elbwald-card"
                    Padding="20">

                    <StackPanel Spacing="9">
                        <TextBlock
                            Text="Daten &amp; Datenschutz"
                            Classes="elbwald-section-title" />

                        <TextBlock
                            Text="Lokale Verarbeitung"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="{Binding DataPolicy}"
                            Classes="elbwald-muted"
                            FontSize="11"
                            LineHeight="18"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Border
                    Classes="elbwald-card"
                    Padding="20"
                    Opacity="0.78">

                    <StackPanel Spacing="7">
                        <TextBlock
                            Text="Standardpfade"
                            Classes="elbwald-section-title" />

                        <TextBlock
                            Text="Geplant"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Bevorzugte Quell-, Ziel- und Arbeitsverzeichnisse folgen in einem späteren Patch."
                            Classes="elbwald-muted"
                            FontSize="11"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Classes="elbwald-card"
                    Padding="20"
                    Opacity="0.78">

                    <StackPanel Spacing="7">
                        <TextBlock
                            Text="Darstellung"
                            Classes="elbwald-section-title" />

                        <TextBlock
                            Text="Geplant"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Theme, Skalierung und weitere Oberflächenoptionen werden später ergänzt."
                            Classes="elbwald-muted"
                            FontSize="11"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
