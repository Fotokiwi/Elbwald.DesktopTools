<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
    x:Class="Elbwald.DesktopTools.App.Views.ProjectsView"
    x:DataType="vm:ProjectsViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="38,28,38,40" Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="5">
                    <TextBlock Text="Projekte" Classes="elbwald-title" />
                    <TextBlock
                        Text="Logische Sammlungen über dem normalen Dateisystem. Projektzuordnungen referenzieren stabile Media-IDs und bleiben damit auch bei Pfadänderungen erhalten."
                        Classes="elbwald-muted"
                        FontSize="12"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="elbwald-secondary-button"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"
                        Content="Aktualisieren" />
            </Grid>

            <Border Classes="elbwald-card" Padding="16">
                <Grid ColumnDefinitions="*,190,Auto" ColumnSpacing="10">
                    <TextBox Text="{Binding NewProjectName, Mode=TwoWay}"
                             PlaceholderText="Neues Projekt, z. B. Urlaub Ostsee 2026" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ProjectKinds}"
                              SelectedItem="{Binding NewProjectKind, Mode=TwoWay}" />
                    <Button Grid.Column="2"
                            Classes="elbwald-primary-button"
                            Command="{Binding CreateProjectCommand}"
                            Content="Projekt anlegen" />
                </Grid>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Classes="elbwald-muted" FontSize="11" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="300,*" ColumnSpacing="14" MinHeight="560">
                <Border Classes="elbwald-card" Padding="10">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Text="Meine Projekte" Classes="elbwald-section-title" Margin="6,4" />
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Projects}"
                                 SelectedItem="{Binding SelectedProject, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectListItemViewModel">
                                    <Border Padding="10,9">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding DetailText}" Classes="elbwald-muted" FontSize="10" />
                                            <TextBlock Text="{Binding MediaCountText}" Foreground="{DynamicResource ElbwaldAccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" IsVisible="{Binding HasSelectedProject}" RowDefinitions="Auto,Auto,*" RowSpacing="14">
                    <Border Classes="elbwald-card" Padding="16">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <Grid ColumnDefinitions="*,190" ColumnSpacing="10">
                                <TextBox Text="{Binding EditName, Mode=TwoWay}" PlaceholderText="Projektname" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ProjectKinds}" SelectedItem="{Binding EditKind, Mode=TwoWay}" />
                            </Grid>
                            <TextBox Grid.Row="1" Text="{Binding EditLocation, Mode=TwoWay}" PlaceholderText="Ort (optional)" />
                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBox Text="{Binding EditNotes, Mode=TwoWay}" PlaceholderText="Notizen (optional)" AcceptsReturn="True" MinHeight="62" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Classes="elbwald-primary-button" Command="{Binding SaveProjectCommand}" VerticalAlignment="Bottom" Content="Speichern" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Classes="elbwald-card" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Medien hinzufügen" Classes="elbwald-section-title" />
                            <TextBlock Text="Suche im lokalen Medienindex. Hinzugefügt wird ausschließlich die stabile Media-ID – kein Dateipfad wird ins Projekt kopiert." Classes="elbwald-muted" FontSize="10" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Dateiname, Pfad, Media-ID oder SHA-256 …" />
                                <Button Grid.Column="1" Classes="elbwald-secondary-button" Command="{Binding SearchCommand}" Content="Suchen" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasSearchResults}">
                                <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}" MaxHeight="190">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ProjectSearchResultViewModel">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="6">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11" />
                                                    <TextBlock Text="{Binding RelativePath}" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                                    <TextBlock Text="{Binding MediaType}" FontSize="9" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding SizeText}" Classes="elbwald-muted" FontSize="9" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding LocationSummary}" Classes="elbwald-muted" FontSize="9" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Column="1" Classes="elbwald-primary-button" Command="{Binding AddSelectedMediaCommand}" VerticalAlignment="Top" Content="Hinzufügen" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Classes="elbwald-card" Padding="16">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock Text="Projektmedien" Classes="elbwald-section-title" />
                            <Grid Grid.Row="1">
                                <Grid IsVisible="{Binding HasProjectMedia}" RowDefinitions="*,Auto" RowSpacing="8">
                                    <ListBox ItemsSource="{Binding ProjectMedia}"
                                             SelectedItem="{Binding SelectedProjectMedia, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProjectMediaItemViewModel">
                                                <Border Padding="8">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11" />
                                                            <TextBlock Text="{Binding RelativePath}" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding MediaItemId}" Classes="elbwald-muted" FontSize="8" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding MediaType}" FontSize="9" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding SizeText}" Classes="elbwald-muted" FontSize="9" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding EndpointId}" Classes="elbwald-muted" FontSize="8" HorizontalAlignment="Right" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Grid.Row="1" Classes="elbwald-secondary-button" Command="{Binding RemoveMediaCommand}" HorizontalAlignment="Right" Content="Aus Projekt entfernen" />
                                </Grid>
                                <TextBlock IsVisible="{Binding HasNoProjectMedia}"
                                           Text="Noch keine Medien zugeordnet."
                                           Classes="elbwald-muted"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1" IsVisible="{Binding HasNoSelectedProject}" Classes="elbwald-card" Padding="24">
                    <TextBlock Text="Lege links ein Projekt an oder wähle eines aus." Classes="elbwald-muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <Border Classes="elbwald-soft-card" Padding="12">
                <TextBlock
                    Text="0046 speichert nur logische Projektmetadaten und Media-ID-Zuordnungen. Projektaktionen verändern, verschieben oder löschen keine Mediendateien."
                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                    FontSize="10"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
