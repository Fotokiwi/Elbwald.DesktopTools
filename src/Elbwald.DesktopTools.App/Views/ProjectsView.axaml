<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
    x:Class="Elbwald.DesktopTools.App.Views.ProjectsView"
    x:DataType="vm:ProjectsViewModel">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel
            Margin="38,28,38,42"
            MaxWidth="1280"
            HorizontalAlignment="Center"
            Spacing="18">

            <!-- Project collection overview -->
            <StackPanel
                IsVisible="{Binding HasNoSelectedProject}"
                Spacing="18">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Projekte" Classes="elbwald-title" />
                        <TextBlock
                            Text="Plane Urlaube, Fotobücher und andere Vorhaben. Ein Projekt verbindet Medien, Informationen und Tagebucheinträge – ohne Originaldateien zu verschieben."
                            Classes="elbwald-muted"
                            FontSize="12"
                            LineHeight="18"
                            MaxWidth="880"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Classes="elbwald-secondary-button"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"
                        Content="Aktualisieren" />
                </Grid>

                <Border Classes="elbwald-card" Padding="18">
                    <Grid ColumnDefinitions="64,*,180,Auto" ColumnSpacing="14">
                        <Border
                            Width="58"
                            Height="58"
                            CornerRadius="18"
                            Background="{DynamicResource ElbwaldAccentSoftBrush}"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="+"
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                FontSize="28"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock
                                Text="Neues Projekt"
                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <TextBox
                                Text="{Binding NewProjectName, Mode=TwoWay}"
                                PlaceholderText="Name, z. B. Urlaub Ostsee 2026" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock
                                Text="Art des Projekts"
                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                FontSize="10"
                                FontWeight="SemiBold" />
                            <ComboBox
                                ItemsSource="{Binding ProjectKinds}"
                                SelectedItem="{Binding NewProjectKind, Mode=TwoWay}" />
                        </StackPanel>

                        <Button
                            Grid.Column="3"
                            Classes="elbwald-primary-button"
                            Command="{Binding CreateProjectCommand}"
                            VerticalAlignment="Bottom"
                            Content="Projekt anlegen" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock
                            Text="Meine Projekte"
                            Classes="elbwald-section-title" />
                        <TextBlock
                            Text="Wähle ein Projekt aus, um seine Medien, Informationen und Inhalte zu öffnen."
                            Classes="elbwald-muted"
                            FontSize="10.5" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding StatusMessage}"
                        Classes="elbwald-muted"
                        FontSize="10.5"
                        VerticalAlignment="Bottom" />
                </Grid>

                <ListBox
                    ItemsSource="{Binding Projects}"
                    SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                    IsVisible="{Binding HasProjects}"
                    Background="Transparent"
                    BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectListItemViewModel">
                            <Border
                                Classes="elbwald-card"
                                Width="360"
                                Margin="0,0,14,14"
                                ClipToBounds="True">
                                <Grid RowDefinitions="112,Auto">
                                    <Grid ClipToBounds="True">
                                        <Image
                                            IsVisible="{Binding HasNoCoverThumbnail}"
                                            Source="/Assets/Branding/app-background-mist.png"
                                            Stretch="UniformToFill"
                                            Opacity="0.82" />
                                        <Image
                                            IsVisible="{Binding HasCoverThumbnail}"
                                            Source="{Binding CoverThumbnail}"
                                            Stretch="UniformToFill" />
                                        <Border Background="#45000000" />
                                        <StackPanel
                                            Margin="16"
                                            VerticalAlignment="Bottom"
                                            Spacing="3">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                Foreground="White"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding Kind}"
                                                Foreground="White"
                                                FontSize="10"
                                                Opacity="0.9" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid
                                        Grid.Row="1"
                                        Margin="16,13,16,15"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Text="{Binding DetailText}"
                                                Classes="elbwald-muted"
                                                FontSize="10"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding MediaCountText}"
                                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                FontSize="11"
                                                FontWeight="SemiBold" />
                                        </StackPanel>
                                        <PathIcon
                                            Grid.Column="1"
                                            Data="{StaticResource ElbwaldIconArrowRight}"
                                            Width="18"
                                            Height="18"
                                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border
                    IsVisible="{Binding HasNoSelectedProject}"
                    Classes="elbwald-soft-card"
                    Padding="16">
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                        <PathIcon
                            Data="{StaticResource ElbwaldIconCheck}"
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            VerticalAlignment="Top" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Projekte sind virtuelle Sammlungen innerhalb von Elbwald Digital. Ein Medium kann mehreren Projekten gleichzeitig zugeordnet sein; seine Datei bleibt an ihrem bisherigen Speicherort."
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontSize="10.5"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Open project workspace -->
            <StackPanel
                IsVisible="{Binding HasSelectedProject}"
                Spacing="16">

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Button
                        Classes="elbwald-secondary-button"
                        Command="{Binding BackToProjectsCommand}"
                        Content="← Alle Projekte" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding SelectedProject.Name}"
                            Foreground="{DynamicResource ElbwaldTextBrush}"
                            FontSize="29"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding SelectedProject.DetailText}"
                            Classes="elbwald-muted"
                            FontSize="11"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Classes="elbwald-secondary-button"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"
                        Content="Aktualisieren" />
                </Grid>

                <Border
                    Classes="elbwald-card"
                    CornerRadius="18"
                    ClipToBounds="True">
                    <Grid Height="160">
                        <Image
                            IsVisible="{Binding SelectedProject.HasNoCoverThumbnail}"
                            Source="/Assets/Branding/app-background-mist.png"
                            Stretch="UniformToFill"
                            Opacity="0.9" />
                        <Image
                            IsVisible="{Binding SelectedProject.HasCoverThumbnail}"
                            Source="{Binding SelectedProject.CoverThumbnail}"
                            Stretch="UniformToFill" />
                        <Border Background="#46000000" />
                        <Grid
                            Margin="24,20"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="18">
                            <StackPanel
                                VerticalAlignment="Bottom"
                                Spacing="6">
                                <TextBlock
                                    Text="{Binding SelectedProject.Name}"
                                    Foreground="White"
                                    FontSize="27"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding SelectedProject.DetailText}"
                                    Foreground="White"
                                    FontSize="12"
                                    Opacity="0.92" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Spacing="6">
                                <Border
                                    IsVisible="{Binding IsTravelProject}"
                                    Background="#E6FFFFFF"
                                    CornerRadius="12"
                                    Padding="12,7"
                                    HorizontalAlignment="Right">
                                    <TextBlock
                                        Text="Reiseprofil"
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        FontSize="10"
                                        FontWeight="SemiBold" />
                                </Border>
                                <Border
                                    Background="#DFFFFFFF"
                                    CornerRadius="12"
                                    Padding="12,7">
                                    <TextBlock
                                        Text="{Binding SelectedProject.Kind}"
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        FontWeight="SemiBold" />
                                </Border>
                                <TextBlock
                                    Text="{Binding SelectedProject.MediaCountText}"
                                    Foreground="White"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <TabControl>
                    <!-- Project hub -->
                    <TabItem Header="Übersicht">
                        <StackPanel Margin="0,14,0,0" Spacing="14">
                            <!-- First specialized project profile: travel / vacation.
                                 It uses the normal project data model and only adds a tailored view. -->
                            <Border
                                IsVisible="{Binding IsTravelProject}"
                                Classes="elbwald-card"
                                Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Text="Reise auf einen Blick"
                                                Classes="elbwald-section-title" />
                                            <TextBlock
                                                Text="{Binding TravelDestinationText}"
                                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                                FontSize="22"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding TravelPeriodText}"
                                                Classes="elbwald-muted"
                                                FontSize="11" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="1"
                                            Padding="12,7"
                                            CornerRadius="12"
                                            Background="{DynamicResource ElbwaldAccentSoftBrush}"
                                            VerticalAlignment="Top">
                                            <TextBlock
                                                Text="REISEPROFIL"
                                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                FontSize="9"
                                                FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                        <Border
                                            Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                            CornerRadius="11"
                                            Padding="13,11">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Reisezeit" Classes="elbwald-muted" FontSize="9.5" />
                                                <TextBlock
                                                    Text="{Binding TravelDurationText}"
                                                    Foreground="{DynamicResource ElbwaldTextBrush}"
                                                    FontSize="16"
                                                    FontWeight="SemiBold" />
                                                <TextBlock
                                                    Text="{Binding TravelDocumentationText}"
                                                    Classes="elbwald-muted"
                                                    FontSize="9.5" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Column="1"
                                            Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                            CornerRadius="11"
                                            Padding="13,11">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Tagebuch" Classes="elbwald-muted" FontSize="9.5" />
                                                <TextBlock
                                                    Text="{Binding TravelJournalSummaryText}"
                                                    Foreground="{DynamicResource ElbwaldTextBrush}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Grid.Column="2"
                                            Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                            CornerRadius="11"
                                            Padding="13,11">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Tagesmedien" Classes="elbwald-muted" FontSize="9.5" />
                                                <TextBlock
                                                    Text="{Binding TravelMediaSummaryText}"
                                                    Foreground="{DynamicResource ElbwaldTextBrush}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                Text="Reisetage"
                                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                                FontSize="13"
                                                FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{Binding TravelMissingDaysText}"
                                                Classes="elbwald-muted"
                                                FontSize="10"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="Tag für Tag · ohne neue Dateiablage"
                                            Classes="elbwald-muted"
                                            FontSize="9"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl
                                        IsVisible="{Binding HasTravelDays}"
                                        ItemsSource="{Binding TravelDays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProjectTravelDayViewModel">
                                                <Border
                                                    Width="220"
                                                    MinHeight="132"
                                                    Margin="0,0,10,10"
                                                    Padding="13"
                                                    CornerRadius="12"
                                                    Background="{DynamicResource ElbwaldSurfaceStrongBrush}"
                                                    BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                                                    BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBlock
                                                                Text="{Binding DayLabel}"
                                                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                FontSize="11"
                                                                FontWeight="SemiBold" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                IsVisible="{Binding HasNoContent}"
                                                                Text="offen"
                                                                Classes="elbwald-muted"
                                                                FontSize="8.5" />
                                                        </Grid>
                                                        <TextBlock
                                                            Text="{Binding DateText}"
                                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                                            FontSize="11"
                                                            FontWeight="SemiBold" />
                                                        <TextBlock
                                                            IsVisible="{Binding HasPrimaryTitle}"
                                                            Text="{Binding PrimaryTitle}"
                                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                                            FontSize="10"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            IsVisible="{Binding HasLocation}"
                                                            Text="{Binding LocationText}"
                                                            Classes="elbwald-muted"
                                                            FontSize="9"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Text="{Binding ActivityText}"
                                                            Classes="elbwald-muted"
                                                            FontSize="9.5"
                                                            TextWrapping="Wrap" />

                                                        <ItemsControl
                                                            IsVisible="{Binding HasMedia}"
                                                            ItemsSource="{Binding MediaPreview}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ProjectMediaItemViewModel">
                                                                    <Border
                                                                        Width="48"
                                                                        Height="34"
                                                                        Margin="0,0,5,0"
                                                                        CornerRadius="5"
                                                                        Background="{DynamicResource ElbwaldThumbnailPlaceholderBrush}"
                                                                        ClipToBounds="True">
                                                                        <Grid>
                                                                            <Image
                                                                                IsVisible="{Binding HasThumbnail}"
                                                                                Source="{Binding Thumbnail}"
                                                                                Stretch="UniformToFill" />
                                                                            <TextBlock
                                                                                IsVisible="{Binding HasNoThumbnail}"
                                                                                Text="·"
                                                                                Classes="elbwald-muted"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border
                                        IsVisible="{Binding HasNoTravelDays}"
                                        Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                        CornerRadius="10"
                                        Padding="14,12">
                                        <TextBlock
                                            Text="Für das Reiseprofil fehlen noch Start- und Enddatum. Ergänze den Zeitraum unter „Informationen“; danach erzeugt Elbwald die Reisetage automatisch."
                                            Classes="elbwald-muted"
                                            FontSize="10"
                                            TextWrapping="Wrap" />
                                    </Border>

                                    <TextBlock
                                        IsVisible="{Binding IsTravelOverviewTruncated}"
                                        Text="{Binding TravelRangeNoticeText}"
                                        Classes="elbwald-muted"
                                        FontSize="9.5"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                                <Border Classes="elbwald-card" Padding="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Medien" Classes="elbwald-muted" FontSize="10" />
                                        <TextBlock
                                            Text="{Binding SelectedProject.MediaCountText}"
                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                            FontSize="20"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Alle Medien sind nur logisch mit diesem Projekt verbunden."
                                            Classes="elbwald-muted"
                                            FontSize="9.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="elbwald-card" Padding="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Zeitraum &amp; Ort" Classes="elbwald-muted" FontSize="10" />
                                        <TextBlock
                                            Text="{Binding SelectedProject.DetailText}"
                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="Diese Angaben helfen Elbwald, passende Medien vorzuschlagen."
                                            Classes="elbwald-muted"
                                            FontSize="9.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Classes="elbwald-card" Padding="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Projektart" Classes="elbwald-muted" FontSize="10" />
                                        <TextBlock
                                            Text="{Binding SelectedProject.Kind}"
                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                            FontSize="20"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Urlaub, Fotobuch, Sammlung oder anderes Vorhaben – das Projekt kann später eigene Werkzeuge erhalten."
                                            Classes="elbwald-muted"
                                            FontSize="9.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Classes="elbwald-card" Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Text="Highlights"
                                                Classes="elbwald-section-title" />
                                            <TextBlock
                                                Text="Markiere besondere Projektmedien. Highlights bleiben reine Projektmetadaten und verändern keine Originaldatei."
                                                Classes="elbwald-muted"
                                                FontSize="10.5"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            IsVisible="{Binding HasHighlights}"
                                            Text="★"
                                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                                            FontSize="24"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl
                                        IsVisible="{Binding HasHighlights}"
                                        ItemsSource="{Binding HighlightedMedia}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ProjectMediaItemViewModel">
                                                <Border
                                                    Width="178"
                                                    Margin="0,0,10,10"
                                                    Padding="7"
                                                    CornerRadius="11"
                                                    Background="{DynamicResource ElbwaldSurfaceStrongBrush}"
                                                    BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                                                    BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <Border
                                                            Height="94"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource ElbwaldThumbnailPlaceholderBrush}"
                                                            ClipToBounds="True">
                                                            <Grid>
                                                                <Image
                                                                    IsVisible="{Binding HasThumbnail}"
                                                                    Source="{Binding Thumbnail}"
                                                                    Stretch="UniformToFill" />
                                                                <TextBlock
                                                                    IsVisible="{Binding HasNoThumbnail}"
                                                                    Text="{Binding ThumbnailStatus}"
                                                                    Classes="elbwald-muted"
                                                                    FontSize="9"
                                                                    TextAlignment="Center"
                                                                    TextWrapping="Wrap"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    MaxWidth="145" />
                                                                <Border
                                                                    IsVisible="{Binding IsCover}"
                                                                    Margin="6"
                                                                    Padding="6,3"
                                                                    CornerRadius="8"
                                                                    Background="#D9FFFFFF"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top">
                                                                    <TextBlock
                                                                        Text="Cover"
                                                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                        FontSize="8.5"
                                                                        FontWeight="SemiBold" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock
                                                            Text="{Binding DisplayTitle}"
                                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                                            FontSize="10.5"
                                                            FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border
                                        IsVisible="{Binding HasNoHighlights}"
                                        Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                        CornerRadius="10"
                                        Padding="12,10">
                                        <TextBlock
                                            Text="Noch keine Highlights markiert. Wähle im Reiter „Medien“ ein Medium aus und markiere es als Highlight."
                                            Classes="elbwald-muted"
                                            FontSize="10"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Classes="elbwald-card" Padding="18">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            Text="Nächster sinnvoller Schritt"
                                            Classes="elbwald-section-title" />
                                        <TextBlock
                                            Text="{Binding FindMediaStatus}"
                                            Classes="elbwald-muted"
                                            FontSize="10.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Classes="elbwald-primary-button"
                                        Command="{Binding FindMediaCommand}"
                                        VerticalAlignment="Center"
                                        Content="Passende Medien suchen" />
                                </Grid>
                            </Border>

                            <Border Classes="elbwald-soft-card" Padding="16">
                                <Grid ColumnDefinitions="38,*" ColumnSpacing="12">
                                    <PathIcon
                                        Data="{StaticResource ElbwaldIconProject}"
                                        Width="24"
                                        Height="24"
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            Text="Hier wächst dein Projekt"
                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                            FontSize="15"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Medien, Projektinformationen und Tagebucheinträge bleiben an einem Ort zusammengefasst. Fotobuch- und weitere Content-Studio-Funktionen können darauf später aufbauen."
                                            Classes="elbwald-muted"
                                            FontSize="10.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- Chronological project activity -->
                    <TabItem Header="Verlauf">
                        <StackPanel Margin="0,14,0,0" Spacing="14">
                            <Border Classes="elbwald-card" Padding="18">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            Text="Projektverlauf"
                                            Classes="elbwald-section-title" />
                                        <TextBlock
                                            Text="Tagebuch und bewusst zugeordnete Tagesmedien werden zu einer chronologischen Projektgeschichte zusammengeführt."
                                            Classes="elbwald-muted"
                                            FontSize="10.5"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="{Binding ProjectTimelineSummaryText}"
                                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                                            FontSize="11"
                                            FontWeight="SemiBold" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="1"
                                        Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                        CornerRadius="10"
                                        Padding="12,9"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{Binding UnassignedProjectMediaText}"
                                            Classes="elbwald-muted"
                                            FontSize="9.5"
                                            MaxWidth="310"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </Grid>
                            </Border>

                            <ItemsControl
                                IsVisible="{Binding HasProjectTimeline}"
                                ItemsSource="{Binding ProjectTimeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProjectTimelineDayViewModel">
                                        <Grid
                                            Margin="0,0,0,14"
                                            ColumnDefinitions="92,*"
                                            ColumnSpacing="14">
                                            <Grid>
                                                <Border
                                                    Width="68"
                                                    MinHeight="68"
                                                    Padding="8"
                                                    CornerRadius="18"
                                                    Background="{DynamicResource ElbwaldAccentSoftBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top">
                                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding DayNumberText}"
                                                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            HorizontalAlignment="Center" />
                                                        <TextBlock
                                                            Text="{Binding ShortDateText}"
                                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                                            FontSize="10"
                                                            HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <Border
                                                    Width="2"
                                                    Margin="0,72,0,-18"
                                                    Background="{DynamicResource ElbwaldBorderBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Stretch"
                                                    IsHitTestVisible="False" />
                                            </Grid>

                                            <Border
                                                Grid.Column="1"
                                                Classes="elbwald-card"
                                                Padding="18">
                                                <StackPanel Spacing="13">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock
                                                                Text="{Binding DateText}"
                                                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                                                FontSize="17"
                                                                FontWeight="SemiBold" />
                                                            <TextBlock
                                                                IsVisible="{Binding HasLocation}"
                                                                Text="{Binding LocationText}"
                                                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                FontSize="10.5" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Border
                                                                Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                                                CornerRadius="9"
                                                                Padding="8,5">
                                                                <TextBlock
                                                                    Text="{Binding JournalCountText}"
                                                                    Classes="elbwald-muted"
                                                                    FontSize="9.5" />
                                                            </Border>
                                                            <Border
                                                                Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                                                CornerRadius="9"
                                                                Padding="8,5">
                                                                <TextBlock
                                                                    Text="{Binding MediaCountText}"
                                                                    Classes="elbwald-muted"
                                                                    FontSize="9.5" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <ItemsControl
                                                        IsVisible="{Binding HasJournalEntries}"
                                                        ItemsSource="{Binding JournalEntries}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ProjectJournalEntryItemViewModel">
                                                                <Border
                                                                    Margin="0,0,0,7"
                                                                    Padding="12,10"
                                                                    CornerRadius="10"
                                                                    Background="{DynamicResource ElbwaldSurfaceQuietBrush}">
                                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                                        <StackPanel Spacing="3">
                                                                            <TextBlock
                                                                                Text="{Binding Title}"
                                                                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                                                                FontSize="11.5"
                                                                                FontWeight="SemiBold" />
                                                                            <TextBlock
                                                                                Text="{Binding PreviewText}"
                                                                                Classes="elbwald-muted"
                                                                                FontSize="9.5"
                                                                                MaxLines="2"
                                                                                TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Text="{Binding MediaCountText}"
                                                                            Classes="elbwald-muted"
                                                                            FontSize="9"
                                                                            VerticalAlignment="Top" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <ItemsControl
                                                        IsVisible="{Binding HasMedia}"
                                                        ItemsSource="{Binding MediaPreview}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ProjectMediaItemViewModel">
                                                                <Border
                                                                    Width="122"
                                                                    Margin="0,0,8,8"
                                                                    Padding="5"
                                                                    CornerRadius="9"
                                                                    Background="{DynamicResource ElbwaldSurfaceStrongBrush}"
                                                                    BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                                                                    BorderThickness="1">
                                                                    <StackPanel Spacing="5">
                                                                        <Border
                                                                            Height="70"
                                                                            CornerRadius="7"
                                                                            Background="{DynamicResource ElbwaldThumbnailPlaceholderBrush}"
                                                                            ClipToBounds="True">
                                                                            <Grid>
                                                                                <Image
                                                                                    IsVisible="{Binding HasThumbnail}"
                                                                                    Source="{Binding Thumbnail}"
                                                                                    Stretch="UniformToFill" />
                                                                                <TextBlock
                                                                                    IsVisible="{Binding HasNoThumbnail}"
                                                                                    Text="{Binding ThumbnailStatus}"
                                                                                    Classes="elbwald-muted"
                                                                                    FontSize="8"
                                                                                    TextAlignment="Center"
                                                                                    TextWrapping="Wrap"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    MaxWidth="100" />
                                                                                <TextBlock
                                                                                    IsVisible="{Binding IsHighlight}"
                                                                                    Text="★"
                                                                                    Margin="5"
                                                                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                                    FontSize="16"
                                                                                    HorizontalAlignment="Right"
                                                                                    VerticalAlignment="Top" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <TextBlock
                                                                            Text="{Binding DisplayTitle}"
                                                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                                                            FontSize="9"
                                                                            TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock
                                                        IsVisible="{Binding HasMoreMedia}"
                                                        Text="{Binding MoreMediaText}"
                                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                        FontSize="9.5"
                                                        FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border
                                IsVisible="{Binding HasNoProjectTimeline}"
                                Classes="elbwald-soft-card"
                                Padding="18">
                                <Grid ColumnDefinitions="34,*" ColumnSpacing="12">
                                    <PathIcon
                                        Data="{StaticResource ElbwaldIconProject}"
                                        Width="22"
                                        Height="22"
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            Text="Noch kein Projektverlauf"
                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                            FontSize="14"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Sobald du Tagebucheinträge anlegst oder Medien einem Projekttag zuordnest, entsteht hier automatisch die chronologische Geschichte des Projekts."
                                            Classes="elbwald-muted"
                                            FontSize="10.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- Project media -->
                    <TabItem Header="Medien">
                        <StackPanel Margin="0,14,0,0" Spacing="14">
                            <Border Classes="elbwald-card" Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Passende Medien finden" Classes="elbwald-section-title" />
                                            <TextBlock
                                                Text="Elbwald nutzt den Projektzeitraum als Rahmen und bewertet Treffer zusätzlich anhand bereits zugeordneter Medien – unter anderem Kamera, GPS-Nähe, Pfad und zeitliche Nähe."
                                                Classes="elbwald-muted"
                                                FontSize="10.5"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Classes="elbwald-secondary-button"
                                            Command="{Binding FindMediaCommand}"
                                            VerticalAlignment="Center"
                                            Content="Zeitraum durchsuchen" />
                                    </Grid>

                                    <Border
                                        Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                        CornerRadius="10"
                                        Padding="12,9">
                                        <TextBlock
                                            Text="{Binding FindMediaStatus}"
                                            Classes="elbwald-muted"
                                            FontSize="10"
                                            TextWrapping="Wrap" />
                                    </Border>

                                    <Grid
                                        IsVisible="{Binding HasSuggestedMedia}"
                                        RowDefinitions="*,Auto"
                                        RowSpacing="10">
                                        <ScrollViewer
                                            MaxHeight="260"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SuggestedMedia}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ProjectSearchResultViewModel">
                                                        <Border
                                                            BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="8,9">
                                                            <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="10">
                                                                <CheckBox
                                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                    VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Spacing="2">
                                                                    <TextBlock
                                                                        Text="{Binding FileName}"
                                                                        FontWeight="SemiBold"
                                                                        FontSize="11"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Text="{Binding RelativePath}"
                                                                        Classes="elbwald-muted"
                                                                        FontSize="9"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        IsVisible="{Binding HasSuggestionDetails}"
                                                                        Text="{Binding SuggestionReasons}"
                                                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                        FontSize="8.8"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                                                    <TextBlock
                                                                        Text="{Binding SuggestionStrengthText}"
                                                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                        FontSize="9.5"
                                                                        FontWeight="SemiBold"
                                                                        HorizontalAlignment="Right" />
                                                                    <TextBlock
                                                                        Text="{Binding CaptureDateText}"
                                                                        Classes="elbwald-muted"
                                                                        FontSize="9"
                                                                        HorizontalAlignment="Right" />
                                                                    <TextBlock
                                                                        Text="{Binding RatingText}"
                                                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                        FontSize="9"
                                                                        HorizontalAlignment="Right" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <Button
                                            Grid.Row="1"
                                            Classes="elbwald-primary-button"
                                            HorizontalAlignment="Right"
                                            Command="{Binding AddSuggestedMediaCommand}"
                                            Content="Ausgewählte Medien hinzufügen" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="elbwald-card" Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Medien im Projekt" Classes="elbwald-section-title" />
                                            <TextBlock
                                                Text="{Binding SelectedProjectMediaCountText}"
                                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                FontSize="10.5"
                                                FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                            <Button
                                                Classes="elbwald-secondary-button"
                                                Command="{Binding ToggleHighlightCommand}"
                                                Content="{Binding SelectedProjectMedia.HighlightActionText}" />
                                            <Button
                                                Classes="elbwald-secondary-button"
                                                Command="{Binding SetCoverCommand}"
                                                Content="Als Cover verwenden" />
                                            <Button
                                                Classes="elbwald-secondary-button"
                                                Command="{Binding ClearCoverCommand}"
                                                Content="Cover entfernen" />
                                            <Button
                                                Classes="elbwald-secondary-button"
                                                Command="{Binding RemoveMediaCommand}"
                                                Content="Aus Projekt entfernen" />
                                        </StackPanel>
                                    </Grid>

                                    <Border
                                        IsVisible="{Binding HasSelectedProjectMedia}"
                                        Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                        CornerRadius="10"
                                        Padding="12,10">
                                        <Grid ColumnDefinitions="Auto,150,Auto,Auto,*" ColumnSpacing="9">
                                            <TextBlock
                                                Text="Projekt-Tag"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center" />
                                            <TextBox
                                                Grid.Column="1"
                                                Text="{Binding MediaDayDateText, Mode=TwoWay}"
                                                PlaceholderText="TT.MM.JJJJ" />
                                            <Button
                                                Grid.Column="2"
                                                Classes="elbwald-primary-button"
                                                Command="{Binding AssignMediaDayCommand}"
                                                Content="Tag zuweisen" />
                                            <Button
                                                Grid.Column="3"
                                                Classes="elbwald-secondary-button"
                                                Command="{Binding ClearMediaDayCommand}"
                                                Content="Zuordnung lösen" />
                                            <TextBlock
                                                Grid.Column="4"
                                                Text="{Binding MediaDayStatus}"
                                                Classes="elbwald-muted"
                                                FontSize="9"
                                                VerticalAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <ListBox
                                            IsVisible="{Binding HasProjectMedia}"
                                            ItemsSource="{Binding ProjectMedia}"
                                            SelectedItem="{Binding SelectedProjectMedia, Mode=TwoWay}"
                                            MaxHeight="540"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>

                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProjectMediaItemViewModel">
                                                    <Border
                                                        Width="190"
                                                        Margin="0,0,12,12"
                                                        Padding="8"
                                                        CornerRadius="12"
                                                        Background="{DynamicResource ElbwaldSurfaceStrongBrush}"
                                                        BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                                                        BorderThickness="1">
                                                        <StackPanel Spacing="7">
                                                            <Border
                                                                Height="124"
                                                                CornerRadius="9"
                                                                Background="{DynamicResource ElbwaldThumbnailPlaceholderBrush}"
                                                                ClipToBounds="True">
                                                                <Grid>
                                                                    <Image
                                                                        IsVisible="{Binding HasThumbnail}"
                                                                        Source="{Binding Thumbnail}"
                                                                        Stretch="UniformToFill" />

                                                                    <Border
                                                                        IsVisible="{Binding IsHighlight}"
                                                                        Margin="7"
                                                                        Padding="7,4"
                                                                        CornerRadius="9"
                                                                        Background="#D9243328"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Top">
                                                                        <TextBlock
                                                                            Text="★ Highlight"
                                                                            Foreground="White"
                                                                            FontSize="9"
                                                                            FontWeight="SemiBold" />
                                                                    </Border>

                                                                    <Border
                                                                        IsVisible="{Binding IsCover}"
                                                                        Margin="7"
                                                                        Padding="7,4"
                                                                        CornerRadius="9"
                                                                        Background="#D9FFFFFF"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top">
                                                                        <TextBlock
                                                                            Text="Cover"
                                                                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                            FontSize="9"
                                                                            FontWeight="SemiBold" />
                                                                    </Border>

                                                                    <Border
                                                                        IsVisible="{Binding HasProjectDate}"
                                                                        Margin="7"
                                                                        Padding="7,4"
                                                                        CornerRadius="9"
                                                                        Background="#D9243328"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Bottom">
                                                                        <TextBlock
                                                                            Text="{Binding ProjectDayBadgeText}"
                                                                            Foreground="White"
                                                                            FontSize="8.8"
                                                                            FontWeight="SemiBold" />
                                                                    </Border>

                                                                    <StackPanel
                                                                        IsVisible="{Binding HasNoThumbnail}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Spacing="5">
                                                                        <PathIcon
                                                                            Data="{StaticResource ElbwaldIconCamera}"
                                                                            Width="23"
                                                                            Height="23"
                                                                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                            HorizontalAlignment="Center" />
                                                                        <TextBlock
                                                                            Text="{Binding ThumbnailStatus}"
                                                                            Classes="elbwald-muted"
                                                                            FontSize="9.5"
                                                                            MaxWidth="150"
                                                                            TextAlignment="Center"
                                                                            TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <TextBlock
                                                                Text="{Binding DisplayTitle}"
                                                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                                                FontWeight="SemiBold"
                                                                FontSize="11"
                                                                MaxWidth="174"
                                                                TextTrimming="CharacterEllipsis" />

                                                            <TextBlock
                                                                Text="{Binding FileName}"
                                                                Classes="elbwald-muted"
                                                                FontSize="9"
                                                                MaxWidth="174"
                                                                TextTrimming="CharacterEllipsis" />

                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock
                                                                    Text="{Binding MediaType}"
                                                                    Classes="elbwald-muted"
                                                                    FontSize="8.5"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4">
                                                                    <TextBlock
                                                                        Text="{Binding SizeText}"
                                                                        Classes="elbwald-muted"
                                                                        FontSize="8.5" />
                                                                    <TextBlock
                                                                        Text="·"
                                                                        Classes="elbwald-muted"
                                                                        FontSize="8.5" />
                                                                    <TextBlock
                                                                        Text="{Binding AddedAtText}"
                                                                        Classes="elbwald-muted"
                                                                        FontSize="8.5" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel
                                            IsVisible="{Binding HasNoProjectMedia}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0,30"
                                            Spacing="7">
                                            <TextBlock
                                                Text="Noch keine Medien im Projekt"
                                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                                FontWeight="SemiBold"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                Text="Lege unter Informationen einen Zeitraum fest und lass dir anschließend passende Medien vorschlagen."
                                                Classes="elbwald-muted"
                                                FontSize="10"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <Expander Header="Weitere Medien gezielt hinzufügen" IsExpanded="False">
                                        <StackPanel Margin="0,10,0,0" Spacing="10">
                                            <TextBlock
                                                Text="Suche nach einem Dateinamen oder Ordner, wenn ein Medium nicht automatisch vorgeschlagen wurde."
                                                Classes="elbwald-muted"
                                                FontSize="10"
                                                TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBox
                                                    Text="{Binding SearchText, Mode=TwoWay}"
                                                    PlaceholderText="Dateiname oder Ordner suchen …" />
                                                <Button
                                                    Grid.Column="1"
                                                    Classes="elbwald-secondary-button"
                                                    Command="{Binding SearchCommand}"
                                                    Content="Suchen" />
                                            </Grid>

                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding HasSearchResults}">
                                                <ListBox
                                                    ItemsSource="{Binding SearchResults}"
                                                    SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                                    MaxHeight="220">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ProjectSearchResultViewModel">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="7">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding RelativePath}" Classes="elbwald-muted" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                                                    <TextBlock Text="{Binding MediaType}" FontSize="9" HorizontalAlignment="Right" />
                                                                    <TextBlock Text="{Binding SizeText}" Classes="elbwald-muted" FontSize="9" HorizontalAlignment="Right" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Button
                                                    Grid.Column="1"
                                                    Classes="elbwald-primary-button"
                                                    Command="{Binding AddSelectedMediaCommand}"
                                                    VerticalAlignment="Top"
                                                    Content="Hinzufügen" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- Project journal -->
                    <TabItem Header="Tagebuch">
                        <StackPanel Margin="0,14,0,0" Spacing="14">
                            <Border Classes="elbwald-card" Padding="18">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Projekttagebuch" Classes="elbwald-section-title" />
                                        <TextBlock
                                            Text="Halte Tage, Etappen und Erinnerungen direkt im Projekt fest. Verknüpfte Medien bleiben normale Dateien und werden nur referenziert."
                                            Classes="elbwald-muted"
                                            FontSize="10.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Classes="elbwald-primary-button"
                                        Command="{Binding NewJournalEntryCommand}"
                                        VerticalAlignment="Center"
                                        Content="Neuer Eintrag" />
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="360,*" ColumnSpacing="14">
                                <Border Classes="elbwald-card" Padding="16">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Einträge" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock
                                                Text="Neueste Tage zuerst"
                                                Classes="elbwald-muted"
                                                FontSize="9.5" />
                                        </StackPanel>

                                        <ListBox
                                            ItemsSource="{Binding JournalEntries}"
                                            SelectedItem="{Binding SelectedJournalEntry, Mode=TwoWay}"
                                            IsVisible="{Binding HasJournalEntries}"
                                            MaxHeight="520"
                                            Background="Transparent"
                                            BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProjectJournalEntryItemViewModel">
                                                    <StackPanel>
                                                        <TextBlock
                                                            IsVisible="{Binding ShowDayHeader}"
                                                            Margin="2,8,2,6"
                                                            Text="{Binding DayHeaderText}"
                                                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                            FontSize="10"
                                                            FontWeight="SemiBold" />
                                                        <Border
                                                            Margin="0,0,0,8"
                                                            Padding="11"
                                                            CornerRadius="10"
                                                            BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource ElbwaldSurfaceQuietBrush}">
                                                            <StackPanel Spacing="5">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock
                                                                    Text="{Binding Title}"
                                                                    FontWeight="SemiBold"
                                                                    FontSize="11.5"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Text="{Binding DateText}"
                                                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                    FontWeight="SemiBold"
                                                                    FontSize="9.5" />
                                                            </Grid>
                                                            <TextBlock
                                                                Text="{Binding PreviewText}"
                                                                Classes="elbwald-muted"
                                                                FontSize="9.5"
                                                                MaxHeight="34"
                                                                ClipToBounds="True"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="Wrap" />
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <TextBlock
                                                                    Text="{Binding LocationText}"
                                                                    Classes="elbwald-muted"
                                                                    FontSize="9" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Text="{Binding MediaCountText}"
                                                                    Classes="elbwald-muted"
                                                                    FontSize="9" />
                                                            </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Border
                                            IsVisible="{Binding HasNoJournalEntries}"
                                            Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                            CornerRadius="10"
                                            Padding="14">
                                            <StackPanel Spacing="5">
                                                <TextBlock
                                                    Text="Noch kein Eintrag"
                                                    FontWeight="SemiBold"
                                                    FontSize="11" />
                                                <TextBlock
                                                    Text="Lege rechts deinen ersten Tagebucheintrag an."
                                                    Classes="elbwald-muted"
                                                    FontSize="9.5"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="elbwald-card" Padding="18">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock
                                                    Text="{Binding JournalEditorHeading}"
                                                    Classes="elbwald-section-title" />
                                                <TextBlock
                                                    Text="Datum und Titel reichen für einen Eintrag. Danach speichert Elbwald Änderungen automatisch."
                                                    Classes="elbwald-muted"
                                                    FontSize="9.5"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding JournalAutosaveStatus}"
                                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                FontSize="9.5"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Top" />
                                        </Grid>

                                        <Grid ColumnDefinitions="170,*" ColumnSpacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Datum" FontSize="10" FontWeight="SemiBold" />
                                                <TextBox
                                                    Text="{Binding JournalDateText, Mode=TwoWay}"
                                                    PlaceholderText="z. B. 16.07.2026" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Titel" FontSize="10" FontWeight="SemiBold" />
                                                <TextBox
                                                    Text="{Binding JournalTitle, Mode=TwoWay}"
                                                    PlaceholderText="z. B. Kreidefelsen und Königsstuhl" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Ort" FontSize="10" FontWeight="SemiBold" />
                                            <TextBox
                                                Text="{Binding JournalLocation, Mode=TwoWay}"
                                                PlaceholderText="Optional, z. B. Sassnitz" />
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Text" FontSize="10" FontWeight="SemiBold" />
                                                    <TextBlock
                                                        Text="Einfache Markdown-Formatierung · bleibt als portabler Klartext gespeichert"
                                                        Classes="elbwald-muted"
                                                        FontSize="8.5" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="5"
                                                    VerticalAlignment="Bottom">
                                                    <Button
                                                        Classes="elbwald-secondary-button"
                                                        Padding="10,5"
                                                        Command="{Binding FormatJournalHeadingCommand}"
                                                        Content="H2"
                                                        ToolTip.Tip="Überschrift" />
                                                    <Button
                                                        Classes="elbwald-secondary-button"
                                                        Padding="10,5"
                                                        Command="{Binding FormatJournalBoldCommand}"
                                                        Content="B"
                                                        FontWeight="Bold"
                                                        ToolTip.Tip="Fett" />
                                                    <Button
                                                        Classes="elbwald-secondary-button"
                                                        Padding="10,5"
                                                        Command="{Binding FormatJournalItalicCommand}"
                                                        Content="I"
                                                        FontStyle="Italic"
                                                        ToolTip.Tip="Kursiv" />
                                                    <Button
                                                        Classes="elbwald-secondary-button"
                                                        Padding="10,5"
                                                        Command="{Binding FormatJournalListCommand}"
                                                        Content="Liste"
                                                        ToolTip.Tip="Aufzählung" />
                                                    <Button
                                                        Classes="elbwald-secondary-button"
                                                        Padding="10,5"
                                                        Command="{Binding FormatJournalQuoteCommand}"
                                                        Content="Zitat"
                                                        ToolTip.Tip="Zitat" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBox
                                                Text="{Binding JournalBody, Mode=TwoWay}"
                                                SelectionStart="{Binding JournalSelectionStart, Mode=TwoWay}"
                                                SelectionEnd="{Binding JournalSelectionEnd, Mode=TwoWay}"
                                                PlaceholderText="Was ist an diesem Tag passiert?"
                                                AcceptsReturn="True"
                                                TextWrapping="Wrap"
                                                MinHeight="320"
                                                VerticalContentAlignment="Top" />
                                        </StackPanel>

                                        <StackPanel Spacing="7">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <StackPanel Spacing="2">
                                                    <TextBlock
                                                        Text="Projektmedien verknüpfen"
                                                        FontSize="10"
                                                        FontWeight="SemiBold" />
                                                    <TextBlock
                                                        Text="{Binding JournalDayMediaSuggestionText}"
                                                        Classes="elbwald-muted"
                                                        FontSize="9" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    Classes="elbwald-secondary-button"
                                                    Command="{Binding SelectJournalDayMediaCommand}"
                                                    Content="Tagesmedien auswählen"
                                                    VerticalAlignment="Center" />
                                                <Button
                                                    Grid.Column="2"
                                                    Classes="elbwald-secondary-button"
                                                    Command="{Binding AssignSelectedJournalMediaToDayCommand}"
                                                    Content="Auswahl diesem Tag zuordnen"
                                                    VerticalAlignment="Center" />
                                            </Grid>

                                            <ListBox
                                                ItemsSource="{Binding JournalMediaOptions}"
                                                MaxHeight="190"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource ElbwaldBorderBrush}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ProjectJournalMediaOptionViewModel">
                                                        <Grid Margin="8,5" ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                                            <CheckBox
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Spacing="1">
                                                                <TextBlock
                                                                    Text="{Binding Title}"
                                                                    FontSize="10"
                                                                    FontWeight="SemiBold"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Text="{Binding Detail}"
                                                                    Classes="elbwald-muted"
                                                                    FontSize="8.5"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <Grid
                                                                    IsVisible="{Binding HasDayHint}"
                                                                    ColumnDefinitions="*,Auto"
                                                                    ColumnSpacing="8">
                                                                    <TextBlock
                                                                        Text="{Binding DayHintText}"
                                                                        Classes="elbwald-muted"
                                                                        FontSize="8.3"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Text="{Binding DaySuggestionText}"
                                                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                        FontSize="8.3"
                                                                        FontWeight="SemiBold" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>

                                        <Border
                                            Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                            CornerRadius="10"
                                            Padding="11,9">
                                            <TextBlock
                                                Text="{Binding JournalStatus}"
                                                Classes="elbwald-muted"
                                                FontSize="9.5"
                                                TextWrapping="Wrap" />
                                        </Border>

                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Button
                                                IsVisible="{Binding IsEditingExistingJournalEntry}"
                                                Classes="elbwald-secondary-button"
                                                Command="{Binding DeleteJournalEntryCommand}"
                                                Content="{Binding JournalDeleteButtonText}" />
                                            <Button
                                                Grid.Column="2"
                                                Classes="elbwald-primary-button"
                                                Command="{Binding SaveJournalEntryCommand}"
                                                Content="Jetzt speichern" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <!-- Project metadata -->
                    <TabItem Header="Informationen">
                        <Border
                            Margin="0,14,0,0"
                            Classes="elbwald-card"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Projektinformationen" Classes="elbwald-section-title" />
                                    <TextBlock
                                        Text="Diese Angaben beschreiben dein Projekt und helfen bei automatischen Medienvorschlägen."
                                        Classes="elbwald-muted"
                                        FontSize="10.5"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Projektname" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding EditName, Mode=TwoWay}" PlaceholderText="Projektname" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Art des Projekts" FontSize="10" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{Binding ProjectKinds}" SelectedItem="{Binding EditKind, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Text="Von" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding EditStartDateText, Mode=TwoWay}" PlaceholderText="z. B. 01.07.2026" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Bis" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding EditEndDateText, Mode=TwoWay}" PlaceholderText="z. B. 14.07.2026" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Text="Ort" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding EditLocation, Mode=TwoWay}" PlaceholderText="Optional, z. B. Ostsee" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Notizen" FontSize="10" FontWeight="SemiBold" />
                                    <TextBox
                                        Text="{Binding EditNotes, Mode=TwoWay}"
                                        PlaceholderText="Optional: Erinnerungen, Ideen fürs Fotobuch, Besonderheiten …"
                                        AcceptsReturn="True"
                                        MinHeight="110"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock
                                        Text="{Binding StatusMessage}"
                                        Classes="elbwald-muted"
                                        FontSize="10"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Column="1"
                                        Classes="elbwald-primary-button"
                                        Command="{Binding SaveProjectCommand}"
                                        Content="Änderungen speichern" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>

                <Border Classes="elbwald-soft-card" Padding="13">
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                        <PathIcon
                            Data="{StaticResource ElbwaldIconCheck}"
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            VerticalAlignment="Top" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Dieses Projekt arbeitet mit Referenzen auf deine Medien. Dateien werden durch Projektzuordnungen nicht verschoben, umbenannt oder gelöscht."
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontSize="10.5"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
