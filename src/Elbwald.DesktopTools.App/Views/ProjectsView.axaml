<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
    x:Class="Elbwald.DesktopTools.App.Views.ProjectsView"
    x:DataType="vm:ProjectsViewModel">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel
            Margin="38,28,38,42"
            MaxWidth="1280"
            HorizontalAlignment="Center"
            Spacing="18">

            <!-- Project collection overview -->
            <StackPanel
                IsVisible="{Binding HasNoSelectedProject}"
                Spacing="18">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Projekte" Classes="elbwald-title" />
                        <TextBlock
                            Text="Plane Urlaube, Fotobücher und andere Vorhaben. Ein Projekt verbindet Medien, Informationen und später auch Tagebucheinträge – ohne Originaldateien zu verschieben."
                            Classes="elbwald-muted"
                            FontSize="12"
                            LineHeight="18"
                            MaxWidth="880"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Classes="elbwald-secondary-button"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"
                        Content="Aktualisieren" />
                </Grid>

                <Border Classes="elbwald-card" Padding="18">
                    <Grid ColumnDefinitions="64,*,180,Auto" ColumnSpacing="14">
                        <Border
                            Width="58"
                            Height="58"
                            CornerRadius="18"
                            Background="{DynamicResource ElbwaldAccentSoftBrush}"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="+"
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                FontSize="28"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock
                                Text="Neues Projekt"
                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                FontSize="18"
                                FontWeight="SemiBold" />
                            <TextBox
                                Text="{Binding NewProjectName, Mode=TwoWay}"
                                PlaceholderText="Name, z. B. Urlaub Ostsee 2026" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock
                                Text="Art des Projekts"
                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                FontSize="10"
                                FontWeight="SemiBold" />
                            <ComboBox
                                ItemsSource="{Binding ProjectKinds}"
                                SelectedItem="{Binding NewProjectKind, Mode=TwoWay}" />
                        </StackPanel>

                        <Button
                            Grid.Column="3"
                            Classes="elbwald-primary-button"
                            Command="{Binding CreateProjectCommand}"
                            VerticalAlignment="Bottom"
                            Content="Projekt anlegen" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock
                            Text="Meine Projekte"
                            Classes="elbwald-section-title" />
                        <TextBlock
                            Text="Wähle ein Projekt aus, um seine Medien, Informationen und Inhalte zu öffnen."
                            Classes="elbwald-muted"
                            FontSize="10.5" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding StatusMessage}"
                        Classes="elbwald-muted"
                        FontSize="10.5"
                        VerticalAlignment="Bottom" />
                </Grid>

                <ListBox
                    ItemsSource="{Binding Projects}"
                    SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                    IsVisible="{Binding HasProjects}"
                    Background="Transparent"
                    BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectListItemViewModel">
                            <Border
                                Classes="elbwald-card"
                                Width="360"
                                Margin="0,0,14,14"
                                ClipToBounds="True">
                                <Grid RowDefinitions="112,Auto">
                                    <Grid ClipToBounds="True">
                                        <Image
                                            Source="/Assets/Branding/app-background-mist.png"
                                            Stretch="UniformToFill"
                                            Opacity="0.82" />
                                        <Border Background="#35000000" />
                                        <StackPanel
                                            Margin="16"
                                            VerticalAlignment="Bottom"
                                            Spacing="3">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                Foreground="White"
                                                FontSize="20"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{Binding Kind}"
                                                Foreground="White"
                                                FontSize="10"
                                                Opacity="0.9" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid
                                        Grid.Row="1"
                                        Margin="16,13,16,15"
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Text="{Binding DetailText}"
                                                Classes="elbwald-muted"
                                                FontSize="10"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding MediaCountText}"
                                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                FontSize="11"
                                                FontWeight="SemiBold" />
                                        </StackPanel>
                                        <PathIcon
                                            Grid.Column="1"
                                            Data="{StaticResource ElbwaldIconArrowRight}"
                                            Width="18"
                                            Height="18"
                                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border
                    IsVisible="{Binding HasNoSelectedProject}"
                    Classes="elbwald-soft-card"
                    Padding="16">
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                        <PathIcon
                            Data="{StaticResource ElbwaldIconCheck}"
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            VerticalAlignment="Top" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Projekte sind virtuelle Sammlungen innerhalb von Elbwald Digital. Ein Medium kann mehreren Projekten gleichzeitig zugeordnet sein; seine Datei bleibt an ihrem bisherigen Speicherort."
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontSize="10.5"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Open project workspace -->
            <StackPanel
                IsVisible="{Binding HasSelectedProject}"
                Spacing="16">

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Button
                        Classes="elbwald-secondary-button"
                        Command="{Binding BackToProjectsCommand}"
                        Content="← Alle Projekte" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            Text="{Binding SelectedProject.Name}"
                            Foreground="{DynamicResource ElbwaldTextBrush}"
                            FontSize="29"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding SelectedProject.DetailText}"
                            Classes="elbwald-muted"
                            FontSize="11"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Classes="elbwald-secondary-button"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"
                        Content="Aktualisieren" />
                </Grid>

                <Border
                    Classes="elbwald-card"
                    CornerRadius="18"
                    ClipToBounds="True">
                    <Grid Height="160">
                        <Image
                            Source="/Assets/Branding/app-background-mist.png"
                            Stretch="UniformToFill"
                            Opacity="0.9" />
                        <Border Background="#31000000" />
                        <Grid
                            Margin="24,20"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="18">
                            <StackPanel
                                VerticalAlignment="Bottom"
                                Spacing="6">
                                <TextBlock
                                    Text="{Binding SelectedProject.Name}"
                                    Foreground="White"
                                    FontSize="27"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding SelectedProject.DetailText}"
                                    Foreground="White"
                                    FontSize="12"
                                    Opacity="0.92" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Spacing="6">
                                <Border
                                    Background="#DFFFFFFF"
                                    CornerRadius="12"
                                    Padding="12,7">
                                    <TextBlock
                                        Text="{Binding SelectedProject.Kind}"
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        FontWeight="SemiBold" />
                                </Border>
                                <TextBlock
                                    Text="{Binding SelectedProject.MediaCountText}"
                                    Foreground="White"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <TabControl>
                    <!-- Project hub -->
                    <TabItem Header="Übersicht">
                        <StackPanel Margin="0,14,0,0" Spacing="14">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                                <Border Classes="elbwald-card" Padding="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Medien" Classes="elbwald-muted" FontSize="10" />
                                        <TextBlock
                                            Text="{Binding SelectedProject.MediaCountText}"
                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                            FontSize="20"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Alle Medien sind nur logisch mit diesem Projekt verbunden."
                                            Classes="elbwald-muted"
                                            FontSize="9.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="elbwald-card" Padding="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Zeitraum &amp; Ort" Classes="elbwald-muted" FontSize="10" />
                                        <TextBlock
                                            Text="{Binding SelectedProject.DetailText}"
                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Text="Diese Angaben helfen Elbwald, passende Medien vorzuschlagen."
                                            Classes="elbwald-muted"
                                            FontSize="9.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Classes="elbwald-card" Padding="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Projektart" Classes="elbwald-muted" FontSize="10" />
                                        <TextBlock
                                            Text="{Binding SelectedProject.Kind}"
                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                            FontSize="20"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Urlaub, Fotobuch, Sammlung oder anderes Vorhaben – das Projekt kann später eigene Werkzeuge erhalten."
                                            Classes="elbwald-muted"
                                            FontSize="9.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Classes="elbwald-card" Padding="18">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="5">
                                        <TextBlock
                                            Text="Nächster sinnvoller Schritt"
                                            Classes="elbwald-section-title" />
                                        <TextBlock
                                            Text="{Binding FindMediaStatus}"
                                            Classes="elbwald-muted"
                                            FontSize="10.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Classes="elbwald-primary-button"
                                        Command="{Binding FindMediaCommand}"
                                        VerticalAlignment="Center"
                                        Content="Passende Medien suchen" />
                                </Grid>
                            </Border>

                            <Border Classes="elbwald-soft-card" Padding="16">
                                <Grid ColumnDefinitions="38,*" ColumnSpacing="12">
                                    <PathIcon
                                        Data="{StaticResource ElbwaldIconProject}"
                                        Width="24"
                                        Height="24"
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock
                                            Text="Hier wächst dein Projekt"
                                            Foreground="{DynamicResource ElbwaldTextBrush}"
                                            FontSize="15"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            Text="Medien, Projektinformationen und später auch Tagebucheinträge, Fotobuch-Auswahlen oder andere Inhalte bleiben an einem Ort zusammengefasst."
                                            Classes="elbwald-muted"
                                            FontSize="10.5"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- Project media -->
                    <TabItem Header="Medien">
                        <StackPanel Margin="0,14,0,0" Spacing="14">
                            <Border Classes="elbwald-card" Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Passende Medien finden" Classes="elbwald-section-title" />
                                            <TextBlock
                                                Text="Elbwald durchsucht deine Bibliothek nach Medien, die in den gespeicherten Projektzeitraum passen."
                                                Classes="elbwald-muted"
                                                FontSize="10.5"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Classes="elbwald-secondary-button"
                                            Command="{Binding FindMediaCommand}"
                                            VerticalAlignment="Center"
                                            Content="Zeitraum durchsuchen" />
                                    </Grid>

                                    <Border
                                        Background="{DynamicResource ElbwaldSurfaceQuietBrush}"
                                        CornerRadius="10"
                                        Padding="12,9">
                                        <TextBlock
                                            Text="{Binding FindMediaStatus}"
                                            Classes="elbwald-muted"
                                            FontSize="10"
                                            TextWrapping="Wrap" />
                                    </Border>

                                    <Grid
                                        IsVisible="{Binding HasSuggestedMedia}"
                                        RowDefinitions="*,Auto"
                                        RowSpacing="10">
                                        <ScrollViewer
                                            MaxHeight="260"
                                            VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SuggestedMedia}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ProjectSearchResultViewModel">
                                                        <Border
                                                            BorderBrush="{DynamicResource ElbwaldBorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="8,9">
                                                            <Grid ColumnDefinitions="32,*,Auto" ColumnSpacing="10">
                                                                <CheckBox
                                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                    VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Spacing="2">
                                                                    <TextBlock
                                                                        Text="{Binding FileName}"
                                                                        FontWeight="SemiBold"
                                                                        FontSize="11"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock
                                                                        Text="{Binding RelativePath}"
                                                                        Classes="elbwald-muted"
                                                                        FontSize="9"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                                                    <TextBlock
                                                                        Text="{Binding CaptureDateText}"
                                                                        FontSize="9.5"
                                                                        HorizontalAlignment="Right" />
                                                                    <TextBlock
                                                                        Text="{Binding RatingText}"
                                                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                        FontSize="9"
                                                                        HorizontalAlignment="Right" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <Button
                                            Grid.Row="1"
                                            Classes="elbwald-primary-button"
                                            HorizontalAlignment="Right"
                                            Command="{Binding AddSuggestedMediaCommand}"
                                            Content="Ausgewählte Medien hinzufügen" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Classes="elbwald-card" Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Medien im Projekt" Classes="elbwald-section-title" />
                                            <TextBlock
                                                Text="{Binding SelectedProjectMediaCountText}"
                                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                FontSize="10.5"
                                                FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Classes="elbwald-secondary-button"
                                            Command="{Binding RemoveMediaCommand}"
                                            VerticalAlignment="Center"
                                            Content="Aus Projekt entfernen" />
                                    </Grid>

                                    <Grid>
                                        <ListBox
                                            IsVisible="{Binding HasProjectMedia}"
                                            ItemsSource="{Binding ProjectMedia}"
                                            SelectedItem="{Binding SelectedProjectMedia, Mode=TwoWay}"
                                            MaxHeight="390">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProjectMediaItemViewModel">
                                                    <Border Padding="9,8">
                                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                                            <Border
                                                                Width="38"
                                                                Height="38"
                                                                CornerRadius="11"
                                                                Background="{DynamicResource ElbwaldAccentSoftBrush}"
                                                                VerticalAlignment="Top">
                                                                <PathIcon
                                                                    Data="{StaticResource ElbwaldIconCamera}"
                                                                    Width="17"
                                                                    Height="17"
                                                                    Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                <TextBlock
                                                                    Text="{Binding FileName}"
                                                                    Foreground="{DynamicResource ElbwaldTextBrush}"
                                                                    FontWeight="SemiBold"
                                                                    FontSize="11"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Text="{Binding RelativePath}"
                                                                    Classes="elbwald-muted"
                                                                    FontSize="9"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding MediaType}" FontSize="9.5" HorizontalAlignment="Right" />
                                                                <TextBlock Text="{Binding SizeText}" Classes="elbwald-muted" FontSize="9" HorizontalAlignment="Right" />
                                                                <TextBlock Text="{Binding AddedAtText}" Classes="elbwald-muted" FontSize="8.5" HorizontalAlignment="Right" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel
                                            IsVisible="{Binding HasNoProjectMedia}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0,30"
                                            Spacing="7">
                                            <TextBlock
                                                Text="Noch keine Medien im Projekt"
                                                Foreground="{DynamicResource ElbwaldTextBrush}"
                                                FontWeight="SemiBold"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                Text="Lege unter Informationen einen Zeitraum fest und lass dir anschließend passende Medien vorschlagen."
                                                Classes="elbwald-muted"
                                                FontSize="10"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <Expander Header="Weitere Medien gezielt hinzufügen" IsExpanded="False">
                                        <StackPanel Margin="0,10,0,0" Spacing="10">
                                            <TextBlock
                                                Text="Suche nach einem Dateinamen oder Ordner, wenn ein Medium nicht automatisch vorgeschlagen wurde."
                                                Classes="elbwald-muted"
                                                FontSize="10"
                                                TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBox
                                                    Text="{Binding SearchText, Mode=TwoWay}"
                                                    PlaceholderText="Dateiname oder Ordner suchen …" />
                                                <Button
                                                    Grid.Column="1"
                                                    Classes="elbwald-secondary-button"
                                                    Command="{Binding SearchCommand}"
                                                    Content="Suchen" />
                                            </Grid>

                                            <Grid
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="10"
                                                IsVisible="{Binding HasSearchResults}">
                                                <ListBox
                                                    ItemsSource="{Binding SearchResults}"
                                                    SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                                    MaxHeight="220">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ProjectSearchResultViewModel">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="7">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding RelativePath}" Classes="elbwald-muted" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                                                    <TextBlock Text="{Binding MediaType}" FontSize="9" HorizontalAlignment="Right" />
                                                                    <TextBlock Text="{Binding SizeText}" Classes="elbwald-muted" FontSize="9" HorizontalAlignment="Right" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Button
                                                    Grid.Column="1"
                                                    Classes="elbwald-primary-button"
                                                    Command="{Binding AddSelectedMediaCommand}"
                                                    VerticalAlignment="Top"
                                                    Content="Hinzufügen" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- Future diary -->
                    <TabItem Header="Tagebuch">
                        <Border
                            Margin="0,14,0,0"
                            Classes="elbwald-card"
                            Padding="26">
                            <Grid ColumnDefinitions="72,*" ColumnSpacing="18">
                                <Border
                                    Width="66"
                                    Height="66"
                                    CornerRadius="20"
                                    Background="{DynamicResource ElbwaldAccentSoftBrush}">
                                    <PathIcon
                                        Data="{StaticResource ElbwaldIconEdit}"
                                        Width="28"
                                        Height="28"
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Text="Projekttagebuch"
                                            Classes="elbwald-section-title" />
                                        <Border
                                            Grid.Column="1"
                                            Background="{DynamicResource ElbwaldAccentSoftBrush}"
                                            CornerRadius="10"
                                            Padding="10,5">
                                            <TextBlock
                                                Text="Geplant"
                                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                FontWeight="SemiBold"
                                                FontSize="10" />
                                        </Border>
                                    </Grid>
                                    <TextBlock
                                        Text="Hier können später Reise- und Projekttagebücher entstehen: Tagesnotizen, Erinnerungen und automatisch passende Fotos aus dem jeweiligen Zeitraum."
                                        Classes="elbwald-muted"
                                        FontSize="11"
                                        LineHeight="17"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="Beispiel: 16. Juli · Kreidefelsen – Text schreiben und die an diesem Tag aufgenommenen Bilder direkt zuordnen."
                                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                                        FontSize="10.5"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- Project metadata -->
                    <TabItem Header="Informationen">
                        <Border
                            Margin="0,14,0,0"
                            Classes="elbwald-card"
                            Padding="20">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Projektinformationen" Classes="elbwald-section-title" />
                                    <TextBlock
                                        Text="Diese Angaben beschreiben dein Projekt und helfen bei automatischen Medienvorschlägen."
                                        Classes="elbwald-muted"
                                        FontSize="10.5"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Projektname" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding EditName, Mode=TwoWay}" PlaceholderText="Projektname" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Art des Projekts" FontSize="10" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{Binding ProjectKinds}" SelectedItem="{Binding EditKind, Mode=TwoWay}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock Text="Von" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding EditStartDateText, Mode=TwoWay}" PlaceholderText="z. B. 01.07.2026" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Bis" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding EditEndDateText, Mode=TwoWay}" PlaceholderText="z. B. 14.07.2026" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
                                        <TextBlock Text="Ort" FontSize="10" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding EditLocation, Mode=TwoWay}" PlaceholderText="Optional, z. B. Ostsee" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Notizen" FontSize="10" FontWeight="SemiBold" />
                                    <TextBox
                                        Text="{Binding EditNotes, Mode=TwoWay}"
                                        PlaceholderText="Optional: Erinnerungen, Ideen fürs Fotobuch, Besonderheiten …"
                                        AcceptsReturn="True"
                                        MinHeight="110"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock
                                        Text="{Binding StatusMessage}"
                                        Classes="elbwald-muted"
                                        FontSize="10"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Column="1"
                                        Classes="elbwald-primary-button"
                                        Command="{Binding SaveProjectCommand}"
                                        Content="Änderungen speichern" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>

                <Border Classes="elbwald-soft-card" Padding="13">
                    <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                        <PathIcon
                            Data="{StaticResource ElbwaldIconCheck}"
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            VerticalAlignment="Top" />
                        <TextBlock
                            Grid.Column="1"
                            Text="Dieses Projekt arbeitet mit Referenzen auf deine Medien. Dateien werden durch Projektzuordnungen nicht verschoben, umbenannt oder gelöscht."
                            Foreground="{DynamicResource ElbwaldAccentBrush}"
                            FontSize="10.5"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
