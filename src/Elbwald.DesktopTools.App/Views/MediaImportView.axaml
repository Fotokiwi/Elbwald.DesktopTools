<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
    x:Class="Elbwald.DesktopTools.App.Views.MediaImportView"
    x:DataType="vm:MediaImportViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="42,34,42,42" MaxWidth="1180" Spacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="Importieren" Classes="elbwald-title" />
                <TextBlock
                    Text="Medien sicher in die konfigurierte Import-Wartehalle kopieren. Die Quelle wird beim Import niemals gelöscht oder verändert."
                    Classes="elbwald-muted"
                    FontSize="13"
                    LineHeight="20"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <Border Classes="elbwald-card" Padding="18">
                    <StackPanel Spacing="9">
                        <TextBlock Text="1 · Quelle" Classes="elbwald-section-title" />
                        <TextBlock
                            Text="Kamera, SD-Karte, Smartphone-Mount oder beliebigen Ordner auswählen. Unterordner werden erhalten."
                            Classes="elbwald-muted"
                            FontSize="11"
                            TextWrapping="Wrap" />
                        <Border Classes="elbwald-soft-card" Padding="10" MinHeight="42">
                            <TextBlock Text="{Binding SourcePath}" FontSize="11" TextWrapping="Wrap" />
                        </Border>
                        <Button
                            Classes="elbwald-secondary-button"
                            Command="{Binding ChooseSourceCommand}"
                            HorizontalAlignment="Left"
                            Content="Quelle auswählen" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="elbwald-card" Padding="18">
                    <StackPanel Spacing="9">
                        <TextBlock Text="2 · Import-Wartehalle" Classes="elbwald-section-title" />
                        <TextBlock Text="{Binding DestinationStatus}" Classes="elbwald-muted" FontSize="11" TextWrapping="Wrap" />
                        <Border Classes="elbwald-soft-card" Padding="10" MinHeight="42">
                            <TextBlock Text="{Binding DestinationPath}" FontSize="11" TextWrapping="Wrap" />
                        </Border>
                        <Button
                            Classes="elbwald-secondary-button"
                            Command="{Binding OpenSettingsCommand}"
                            HorizontalAlignment="Left"
                            Content="Speicherorte öffnen" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Classes="elbwald-card" Padding="18">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="3 · Vorschau" Classes="elbwald-section-title" />
                        <TextBlock Text="{Binding StatusMessage}" Classes="elbwald-muted" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="elbwald-primary-button"
                            Command="{Binding CreatePreviewCommand}"
                            Content="Vorschau erstellen" />
                    <Button Grid.Column="2"
                            Classes="elbwald-secondary-button"
                            Command="{Binding CancelCommand}"
                            Content="Abbrechen" />
                </Grid>
            </Border>

            <Grid IsVisible="{Binding HasPlan}" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                <Border Classes="elbwald-card" Padding="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Dateien" Classes="elbwald-muted" FontSize="10" />
                        <TextBlock Text="{Binding FileCount}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalSize}" Classes="elbwald-muted" FontSize="10" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="elbwald-card" Padding="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Importieren" Classes="elbwald-muted" FontSize="10" />
                        <TextBlock Text="{Binding CopyCount}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource ElbwaldAccentBrush}" />
                        <TextBlock Text="{Binding CopySize}" Classes="elbwald-muted" FontSize="10" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="elbwald-card" Padding="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Bereits vorhanden" Classes="elbwald-muted" FontSize="10" />
                        <TextBlock Text="{Binding AlreadyImportedCount}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="SHA-256 identisch" Classes="elbwald-muted" FontSize="10" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="elbwald-card" Padding="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Konflikte" Classes="elbwald-muted" FontSize="10" />
                        <TextBlock Text="{Binding ConflictCount}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="werden übersprungen" Classes="elbwald-muted" FontSize="10" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Classes="elbwald-card" Padding="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Prüfhinweise" Classes="elbwald-muted" FontSize="10" />
                        <TextBlock Text="{Binding IssueCount}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="blockieren bei Unvollständigkeit" Classes="elbwald-muted" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border IsVisible="{Binding HasIssues}" Classes="elbwald-card" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sicherheits-/Scan-Hinweise" Classes="elbwald-section-title" />
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="5" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Classes="elbwald-muted" FontSize="10" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding HasPreviewItems}" Classes="elbwald-card" Padding="14">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Importplan" Classes="elbwald-section-title" />
                        <TextBlock Grid.Column="1" Text="max. 300 Einträge angezeigt" Classes="elbwald-muted" FontSize="9" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" MaxHeight="320" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PreviewItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MediaImportPlanItemViewModel">
                                    <Border Classes="elbwald-soft-card" Padding="10">
                                        <Grid ColumnDefinitions="*,110,120" ColumnSpacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding RelativePath}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Message}" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Size}" Classes="elbwald-muted" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource ElbwaldAccentBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasPlan}" Classes="elbwald-card" Padding="18">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="4 · Sicher importieren" Classes="elbwald-section-title" />
                            <TextBlock
                                Text="Es wird ausschließlich kopiert. Jede neue Datei läuft über .partial, Flush-to-Disk und SHA-256-Verifikation. Vorhandene Ziele werden niemals überschrieben."
                                Classes="elbwald-muted"
                                FontSize="11"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="elbwald-primary-button"
                                Command="{Binding ExecuteImportCommand}"
                                Content="Import starten" />
                    </Grid>

                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" Height="8" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding ProgressText}" Classes="elbwald-muted" FontSize="10" />
                        <TextBlock Grid.Column="1" Text="{Binding Elapsed}" Classes="elbwald-muted" FontSize="10" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding HasResult}" Classes="elbwald-card" Padding="18" Background="#EEF7F1">
                <StackPanel Spacing="5">
                    <TextBlock Text="Import-Ergebnis" Classes="elbwald-section-title" />
                    <TextBlock Text="{Binding ResultMessage}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock
                        Text="Die Quelle bleibt nach dem Import grundsätzlich unverändert. Eine Bereinigung ist nur als separater, mehrfach bestätigter Vorgang möglich."
                        Foreground="{DynamicResource ElbwaldAccentBrush}"
                        FontSize="10"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding CleanupAvailable}" Classes="elbwald-card" Padding="18" BorderBrush="#C58B5C" BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Optional · Importquelle bereinigen" Classes="elbwald-section-title" />
                        <TextBlock
                            Text="Nur Dateien, die in diesem Import neu kopiert und verifiziert wurden, können entfernt werden. Bereits vorhandene Dateien, Konflikte und übersprungene Dateien bleiben unangetastet."
                            Classes="elbwald-muted"
                            FontSize="11"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="Vor einer Löschfreigabe werden Quelle und Zielkopie nochmals vollständig per SHA-256 geprüft."
                            FontSize="10"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="elbwald-secondary-button"
                            Command="{Binding PrepareCleanupCommand}"
                            VerticalAlignment="Center"
                            Content="Quellbereinigung prüfen" />
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasCleanupPlan}" Classes="elbwald-card" Padding="18" BorderBrush="#C58B5C" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Quellbereinigung · Sicherheitsfreigabe" Classes="elbwald-section-title" />
                        <TextBlock Text="{Binding CleanupStatus}" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Classes="elbwald-soft-card" Padding="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Freigegebene Dateien" Classes="elbwald-muted" FontSize="10" />
                                <TextBlock Text="{Binding CleanupFileCount}" FontSize="19" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="elbwald-soft-card" Padding="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Gesamtgröße" Classes="elbwald-muted" FontSize="10" />
                                <TextBlock Text="{Binding CleanupSize}" FontSize="19" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border IsVisible="{Binding HasCleanupIssues}" Background="#FFF3E8" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Bereinigung gesperrt" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding CleanupIssues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <CheckBox IsChecked="{Binding RemoveEmptyDirectories}"
                              Content="Leere Unterordner nach erfolgreicher Dateilöschung ebenfalls entfernen" />

                    <Border Background="#FFF3E8" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Bestätigung 1 von 2" FontWeight="SemiBold" />
                            <TextBlock
                                Text="Ich verstehe, dass die oben freigegebenen Dateien nach einer letzten Sicherheitsprüfung dauerhaft von der Importquelle gelöscht werden. Die verifizierten Kopien in der Import-Wartehalle bleiben erhalten."
                                FontSize="10"
                                TextWrapping="Wrap" />
                            <Button Classes="elbwald-secondary-button"
                                    Command="{Binding ConfirmCleanupWarningCommand}"
                                    HorizontalAlignment="Left"
                                    Content="Ich verstehe – zweite Bestätigung" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding CleanupSecondConfirmationVisible}" Background="#FBE7E5" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="9">
                            <TextBlock Text="Bestätigung 2 von 2" FontWeight="Bold" />
                            <TextBlock
                                Text="Tippe exakt QUELLE LEEREN ein. Erst danach wird die endgültige Löschaktion freigeschaltet."
                                FontSize="10"
                                TextWrapping="Wrap" />
                            <TextBox Text="{Binding CleanupConfirmationText, Mode=TwoWay}"
                                     Watermark="QUELLE LEEREN"
                                     MaxWidth="360"
                                     HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="elbwald-primary-button"
                                        Command="{Binding ExecuteCleanupCommand}"
                                        Content="Verifizierte Quelldateien löschen" />
                                <Button Classes="elbwald-secondary-button"
                                        Command="{Binding CancelCleanupCommand}"
                                        Content="Nicht löschen" />
                            </StackPanel>
                            <TextBlock
                                Text="Nach Beginn der destruktiven Phase wird ein Benutzerabbruch absichtlich ignoriert, damit kein künstlicher Teilzustand entsteht. Bei jeder Abweichung vor dem ersten Löschen wird vollständig blockiert."
                                Classes="elbwald-muted"
                                FontSize="9"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding HasCleanupResult}" Classes="elbwald-card" Padding="18" Background="#EEF7F1">
                <StackPanel Spacing="5">
                    <TextBlock Text="Quellbereinigungs-Report" Classes="elbwald-section-title" />
                    <TextBlock Text="{Binding CleanupResultMessage}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock
                        Text="Jeder Löschlauf erhält eine eigene Report-ID und wird zusätzlich als flush-to-disk JSONL-Sicherheitsprotokoll im Diagnoseverzeichnis dokumentiert."
                        Classes="elbwald-muted"
                        FontSize="10"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
