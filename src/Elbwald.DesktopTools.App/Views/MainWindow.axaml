<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
        x:Class="Elbwald.DesktopTools.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1800"
        Height="900"
        MinWidth="980"
        MinHeight="640"
        Icon="/Assets/avalonia-logo.ico"
        Title="Elbwald Digital – Desktop Tools">

    <Grid
        RowDefinitions="Auto,*"
        ColumnDefinitions="238,*"
        Background="{DynamicResource ElbwaldPageBrush}">

        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="{DynamicResource ElbwaldSidebarBrush}"
            BorderBrush="{DynamicResource ElbwaldBorderBrush}"
            BorderThickness="0,0,0,1">

            <Menu
                Margin="8,0"
                Background="Transparent">
                <MenuItem Header="Datei">
                    <MenuItem
                        Header="Medien analysieren"
                        Command="{Binding NavigateAnalyzeCommand}" />
                    <MenuItem
                        Header="Organisieren"
                        Command="{Binding NavigateOrganizeCommand}" />
                    <Separator />
                    <MenuItem
                        Header="Beenden"
                        Command="{Binding ExitCommand}" />
                </MenuItem>

                <MenuItem Header="Ansicht">
                    <MenuItem
                        Header="Start"
                        Command="{Binding NavigateHomeCommand}" />
                    <MenuItem
                        Header="Analysieren"
                        Command="{Binding NavigateAnalyzeCommand}" />
                    <MenuItem
                        Header="Organisieren"
                        Command="{Binding NavigateOrganizeCommand}" />
                    <MenuItem
                        Header="Bearbeiten"
                        Command="{Binding NavigateEditCommand}" />
                    <MenuItem
                        Header="Sichern"
                        Command="{Binding NavigateBackupCommand}" />
                    <MenuItem
                        Header="Werkzeuge"
                        Command="{Binding NavigateToolsCommand}" />
                    <MenuItem
                        Header="Einstellungen"
                        Command="{Binding NavigateSettingsCommand}" />
                </MenuItem>

                <MenuItem Header="Werkzeuge">
                    <MenuItem
                        Header="Recovery-Status"
                        Command="{Binding NavigateHomeCommand}" />
                    <MenuItem
                        Header="Cache-Verwaltung"
                        Command="{Binding NavigateSettingsCommand}" />
                    <Separator />
                    <MenuItem
                        Header="Einstellungen"
                        Command="{Binding NavigateSettingsCommand}" />
                </MenuItem>

                <MenuItem Header="Hilfe">
                    <MenuItem
                        Header="Über Elbwald Digital"
                        Command="{Binding OpenAboutCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="{DynamicResource ElbwaldSidebarBrush}"
            BorderBrush="{DynamicResource ElbwaldBorderBrush}"
            BorderThickness="0,0,1,0">

            <Grid
                Margin="16"
                RowDefinitions="Auto,Auto,*,Auto">

                <Grid
                    ColumnDefinitions="42,*"
                    Margin="4,8,4,25">

                    <Border
                        Width="38"
                        Height="38"
                        CornerRadius="10"
                        Background="{DynamicResource ElbwaldAccentBrush}">
                        <PathIcon
                            Data="{StaticResource ElbwaldIconTree}"
                            Width="22"
                            Height="22"
                            Foreground="White"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            Text="{Binding ApplicationName}"
                            Foreground="{DynamicResource ElbwaldTextBrush}"
                            FontSize="16"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding ApplicationSubtitle}"
                            Classes="elbwald-muted"
                            FontSize="11" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Margin="10,0,0,7"
                    Text="BEREICHE"
                    Classes="elbwald-muted"
                    FontSize="9"
                    FontWeight="SemiBold" />

                <ListBox
                    Grid.Row="2"
                    Classes="elbwald-nav"
                    ItemsSource="{Binding NavigationItems}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                            <Grid ColumnDefinitions="30,*">
                                <Grid
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">

                                    <PathIcon IsVisible="{Binding IsHome}" Data="{StaticResource ElbwaldIconHome}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsAnalyze}" Data="{StaticResource ElbwaldIconSearch}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsOrganize}" Data="{StaticResource ElbwaldIconFolder}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsEdit}" Data="{StaticResource ElbwaldIconEdit}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsBackup}" Data="{StaticResource ElbwaldIconBackup}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsTools}" Data="{StaticResource ElbwaldIconTool}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsSettings}" Data="{StaticResource ElbwaldIconSettings}" Width="17" Height="17" />
                                </Grid>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel
                    Grid.Row="3"
                    Margin="4,12,4,4"
                    Spacing="7">

                    <Border
                        Padding="10,8"
                        CornerRadius="10"
                        Background="{DynamicResource ElbwaldAccentSoftBrush}">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="{Binding ApplicationVersion}"
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                FontSize="10"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Preview Build"
                                Classes="elbwald-muted"
                                FontSize="9" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Text="{Binding PrivacySummary}"
                        Classes="elbwald-muted"
                        HorizontalAlignment="Center"
                        FontSize="9" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl
            Grid.Row="1"
            Grid.Column="1"
            Content="{Binding CurrentContent}" />
    </Grid>
</Window>
