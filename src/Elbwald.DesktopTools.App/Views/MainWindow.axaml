<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
        x:Class="Elbwald.DesktopTools.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1800"
        Height="900"
        MinWidth="980"
        MinHeight="640"
        Icon="/Assets/avalonia-logo.ico"
        Title="Elbwald Digital – Desktop Tools">

    <Grid
        RowDefinitions="Auto,*"
        ColumnDefinitions="238,*"
        Background="{DynamicResource ElbwaldPageBrush}">

        <Border
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="{DynamicResource ElbwaldSidebarBrush}"
            BorderBrush="{DynamicResource ElbwaldBorderBrush}"
            BorderThickness="0,0,0,1">

            <Menu
                Margin="8,0"
                Background="Transparent">
                <MenuItem Header="Datei">
                    <MenuItem
                        Header="Medien analysieren"
                        Command="{Binding NavigateAnalyzeCommand}" />
                    <MenuItem
                        Header="Importieren"
                        Command="{Binding NavigateImportCommand}" />
                    <MenuItem
                        Header="Organisieren"
                        Command="{Binding NavigateOrganizeCommand}" />
                    <MenuItem
                        Header="Projekte"
                        Command="{Binding NavigateProjectsCommand}" />
                    <Separator />
                    <MenuItem
                        Header="Beenden"
                        Command="{Binding ExitCommand}" />
                </MenuItem>

                <MenuItem Header="Ansicht">
                    <MenuItem
                        Header="Start"
                        Command="{Binding NavigateHomeCommand}" />
                    <MenuItem
                        Header="Analysieren"
                        Command="{Binding NavigateAnalyzeCommand}" />
                    <MenuItem
                        Header="Importieren"
                        Command="{Binding NavigateImportCommand}" />
                    <MenuItem
                        Header="Organisieren"
                        Command="{Binding NavigateOrganizeCommand}" />
                    <MenuItem
                        Header="Bearbeiten"
                        Command="{Binding NavigateEditCommand}" />
                    <MenuItem
                        Header="Sichern"
                        Command="{Binding NavigateBackupCommand}" />
                    <MenuItem
                        Header="Werkzeuge"
                        Command="{Binding NavigateToolsCommand}" />
                    <MenuItem
                        Header="Einstellungen"
                        Command="{Binding NavigateSettingsCommand}" />
                </MenuItem>

                <MenuItem Header="Werkzeuge">
                    <MenuItem
                        Header="Recovery-Status"
                        Command="{Binding NavigateHomeCommand}" />
                    <MenuItem
                        Header="Bibliotheksstatus"
                        Command="{Binding NavigateLibraryHealthCommand}" />
                    <MenuItem
                        Header="Medienindex"
                        Command="{Binding NavigateMediaIndexCommand}" />
                    <MenuItem
                        Header="Protokoll"
                        Command="{Binding NavigateDiagnosticsCommand}" />
                    <MenuItem
                        Header="Cache-Verwaltung"
                        Command="{Binding NavigateSettingsCommand}" />
                    <Separator />
                    <MenuItem
                        Header="Einstellungen"
                        Command="{Binding NavigateSettingsCommand}" />
                </MenuItem>

                <MenuItem Header="Hilfe">
                    <MenuItem
                        Header="Über Elbwald Digital"
                        Command="{Binding OpenAboutCommand}" />
                </MenuItem>
            </Menu>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="{DynamicResource ElbwaldSidebarBrush}"
            BorderBrush="{DynamicResource ElbwaldBorderBrush}"
            BorderThickness="0,0,1,0"
            ClipToBounds="True">

            <Grid>
                <Image
                    Source="/Assets/Branding/sidebar-forest.png"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Height="310"
                    Stretch="UniformToFill"
                    Opacity="0.92"
                    IsHitTestVisible="False" />

                <Grid
                    Margin="16"
                    RowDefinitions="Auto,Auto,*,Auto">

                <Grid
                    ColumnDefinitions="72,*"
                    Margin="4,8,4,25">

                    <Border
                        Width="68"
                        Height="68"
                        CornerRadius="14"
                        Background="Transparent"
                        ClipToBounds="True">
                        <Image
                            Source="/Assets/Branding/tree-logo.png"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            Text="{Binding ApplicationName}"
                            Foreground="{DynamicResource ElbwaldTextBrush}"
                            FontSize="16"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding ApplicationSubtitle}"
                            Classes="elbwald-muted"
                            FontSize="11" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Margin="10,0,0,7"
                    Text="BEREICHE"
                    Classes="elbwald-muted"
                    FontSize="9"
                    FontWeight="SemiBold" />

                <ListBox
                    Grid.Row="2"
                    Classes="elbwald-nav"
                    ItemsSource="{Binding NavigationItems}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                            <Grid ColumnDefinitions="30,*">
                                <Grid
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center">

                                    <PathIcon IsVisible="{Binding IsHome}" Data="{StaticResource ElbwaldIconHome}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsAnalyze}" Data="{StaticResource ElbwaldIconSearch}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsOrganize}" Data="{StaticResource ElbwaldIconFolder}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsEdit}" Data="{StaticResource ElbwaldIconEdit}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsBackup}" Data="{StaticResource ElbwaldIconBackup}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsTools}" Data="{StaticResource ElbwaldIconTool}" Width="17" Height="17" />
                                    <PathIcon IsVisible="{Binding IsSettings}" Data="{StaticResource ElbwaldIconSettings}" Width="17" Height="17" />
                                </Grid>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel
                    Grid.Row="3"
                    Margin="4,12,4,4"
                    Spacing="7"
                    VerticalAlignment="Bottom">

                    <Border
                        Padding="10,8"
                        CornerRadius="10"
                        Background="#ECF5F0E8">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="{Binding ApplicationVersion}"
                                Foreground="{DynamicResource ElbwaldAccentBrush}"
                                FontSize="10"
                                FontWeight="SemiBold" />
                            <TextBlock
                                Text="Preview Build"
                                Classes="elbwald-muted"
                                FontSize="9" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        Text="{Binding PrivacySummary}"
                        Classes="elbwald-muted"
                        HorizontalAlignment="Center"
                        FontSize="9" />
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            ClipToBounds="True">

            <Border
                Height="800"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
                <Border.Background>
                    <ImageBrush
                        Source="/Assets/Branding/hero-landscape.png"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Top" />
                </Border.Background>
            </Border>

            <Border
                Height="800"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush
                        StartPoint="50%,0%"
                        EndPoint="50%,100%">
                        <GradientStop Color="#00FAFCFA" Offset="0.56" />
                        <GradientStop Color="#22FAFCFA" Offset="0.68" />
                        <GradientStop Color="#88FAFCFA" Offset="0.82" />
                        <GradientStop Color="#DDFAFCFA" Offset="0.94" />
                        <GradientStop Color="#FFFAFCFA" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <ContentControl
                Content="{Binding CurrentContent}" />
        </Grid>
    </Grid>
</Window>
