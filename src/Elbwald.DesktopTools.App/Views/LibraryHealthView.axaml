<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Elbwald.DesktopTools.App.ViewModels"
    x:Class="Elbwald.DesktopTools.App.Views.LibraryHealthView"
    x:DataType="vm:LibraryHealthViewModel">

    <Grid
        Margin="38,28,38,34"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,*"
        RowSpacing="16">

        <Grid Grid.Row="0" ColumnDefinitions="*,260" ColumnSpacing="16">
            <StackPanel Spacing="5">
                <TextBlock Text="Bibliotheksstatus" Classes="elbwald-title" />
                <TextBlock
                    Text="Read-only Gesamtüberblick über Speicherorte und Medienindex. Elbwald prüft Verfügbarkeit, Index-Konsistenz und erste Medienauffälligkeiten – ohne Änderungen an Dateien."
                    Classes="elbwald-muted"
                    FontSize="12"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Column="1"
                    Classes="elbwald-soft-card"
                    Padding="14">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastScanMessage}"
                               Foreground="{DynamicResource ElbwaldAccentBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SnapshotFreshnessMessage}"
                               Classes="elbwald-muted"
                               FontSize="10"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Volume-ID statt Pfad · fail closed bei Ambiguität"
                               Classes="elbwald-muted"
                               FontSize="9"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Classes="elbwald-card" Padding="18">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Grid Width="10" MinHeight="72">
                        <Border IsVisible="{Binding HasOverallHealthy}"
                                CornerRadius="5"
                                Background="{DynamicResource ElbwaldAccentBrush}" />
                        <Border IsVisible="{Binding HasOverallWarning}"
                                CornerRadius="5"
                                Background="{DynamicResource ElbwaldWarningBrush}" />
                        <Border IsVisible="{Binding HasOverallProblem}"
                                CornerRadius="5"
                                Background="{DynamicResource ElbwaldDangerBrush}" />
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Gesamtzustand" Classes="elbwald-muted" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock IsVisible="{Binding HasOverallHealthy}"
                                       Text="GESUND"
                                       Foreground="{DynamicResource ElbwaldAccentBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock IsVisible="{Binding HasOverallWarning}"
                                       Text="PRÜFEN"
                                       Foreground="{DynamicResource ElbwaldWarningBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                            <TextBlock IsVisible="{Binding HasOverallProblem}"
                                       Text="HANDLUNGSBEDARF"
                                       Foreground="{DynamicResource ElbwaldDangerBrush}"
                                       FontSize="10"
                                       FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="{Binding OverallHealthTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OverallHealthMessage}" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding OverallHealthHint}" Classes="elbwald-muted" FontSize="10" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusMessage}" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="elbwald-secondary-button"
                                Command="{Binding OpenSettingsCommand}"
                                Content="Speicherorte" />
                        <Button Classes="elbwald-secondary-button"
                                Command="{Binding UpdateMediaIndexCommand}"
                                Content="Index aktualisieren" />
                        <Button Classes="elbwald-secondary-button"
                                Command="{Binding CancelScanCommand}"
                                Content="Abbrechen"
                                IsVisible="{Binding CanCancelScan}" />
                        <Button Classes="elbwald-primary-button"
                                Command="{Binding RefreshCommand}"
                                Content="Neu prüfen" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        IsVisible="{Binding IsSnapshotStale}"
                        Background="{DynamicResource ElbwaldWarningSoftBrush}"
                        CornerRadius="10"
                        Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <TextBlock Text="STATUS VERALTET"
                                   Foreground="{DynamicResource ElbwaldWarningBrush}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SnapshotFreshnessMessage}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        IsVisible="{Binding IsBusy}"
                        Classes="elbwald-soft-card"
                        Padding="12">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding ProgressTitle}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProgressCountMessage}"
                                       Classes="elbwald-muted"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ProgressBar Grid.Row="1"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                     Height="6" />

                        <TextBlock Grid.Row="2"
                                   Text="{Binding ProgressDetail}"
                                   Classes="elbwald-muted"
                                   FontSize="9"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding ProgressDetail}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
            <Border Classes="elbwald-card" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Endpunkte" Classes="elbwald-muted" FontSize="10" />
                    <TextBlock Text="{Binding EndpointSummary}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="elbwald-card" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Verfügbarkeit" Classes="elbwald-muted" FontSize="10" />
                    <TextBlock Text="{Binding AvailabilitySummary}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="elbwald-card" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Warnungen" Classes="elbwald-muted" FontSize="10" />
                    <TextBlock Text="{Binding WarningCount}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Classes="elbwald-card" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Probleme" Classes="elbwald-muted" FontSize="10" />
                    <TextBlock Text="{Binding ProblemCount}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>


        <Border Grid.Row="3" Classes="elbwald-card" Padding="16">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Medienindex-Konsistenz" Classes="elbwald-section-title" />
                        <TextBlock Text="{Binding IndexLastUpdatedMessage}" Classes="elbwald-muted" FontSize="10" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="elbwald-secondary-button"
                            Command="{Binding OpenMediaIndexCommand}"
                            Content="Medienindex öffnen" />
                </Grid>

                <StackPanel Grid.Row="1" Spacing="8">
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <Border Classes="elbwald-soft-card" Padding="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Indexiert" Classes="elbwald-muted" FontSize="9" />
                                <TextBlock Text="{Binding IndexedMediaCount}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding IndexAvailabilitySummary}" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="elbwald-soft-card" Padding="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Erreichbar" Classes="elbwald-muted" FontSize="9" />
                                <TextBlock Text="{Binding PresentIndexedMediaCount}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Physisch geprüft und verfügbar" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Classes="elbwald-soft-card" Padding="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Offline" Classes="elbwald-muted" FontSize="9" />
                                <TextBlock Text="{Binding OfflineIndexedMediaCount}" Foreground="{DynamicResource ElbwaldAccentBrush}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Speicherort nicht verbunden · kein Datenverlust" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Classes="elbwald-soft-card" Padding="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Fehlt / prüfen" Classes="elbwald-muted" FontSize="9" />
                                <TextBlock Text="{Binding MissingIndexedMediaCount}" Foreground="{DynamicResource ElbwaldWarningBrush}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MissingMediaSummary}" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding IndexDetailSummary}" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="2" Classes="elbwald-soft-card" Padding="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <TextBlock Text="Duplicate Finder"
                                   Foreground="{DynamicResource ElbwaldAccentBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Bitidentische Dubletten im Medienindex prüfen" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DuplicateFinderReadinessSummary}" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="elbwald-secondary-button"
                                Command="{Binding OpenDuplicateFinderCommand}"
                                Content="Dubletten prüfen" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="5" Classes="elbwald-card" Padding="16">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="Empfohlene nächste Schritte" Classes="elbwald-section-title" />
                    <TextBlock Text="Priorisiert aus dem aktuellen Health-Report. Elbwald führt keine Reparatur automatisch aus."
                               Classes="elbwald-muted"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              IsVisible="{Binding HasRecommendations}"
                              MaxHeight="230"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryHealthRecommendationItemViewModel">
                                <Border Classes="elbwald-soft-card" Padding="12">
                                    <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding Priority}"
                                                   Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Description}" Classes="elbwald-muted" FontSize="10" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Classes="elbwald-secondary-button"
                                                Command="{Binding ActionCommand}"
                                                Content="{Binding ActionLabel}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="1"
                           IsVisible="{Binding HasNoRecommendations}"
                           Text="Aktuell ist keine Aktion erforderlich."
                           Classes="elbwald-muted"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="6" Classes="elbwald-card" Padding="14">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <TextBlock Text="Speicherorte" Classes="elbwald-section-title" />
                <Grid Grid.Row="1">
                    <ScrollViewer IsVisible="{Binding HasEndpoints}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Endpoints}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LibraryHealthEndpointItemViewModel">
                                    <Border Classes="elbwald-soft-card" Padding="14">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Kind}"
                                                               Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                                <TextBlock Text="{Binding StatusTitle}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusMessage}" Classes="elbwald-muted" FontSize="11" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding IndexStatusText}" Foreground="{DynamicResource ElbwaldAccentBrush}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock IsVisible="{Binding HasResolvedPath}" Text="{Binding ResolvedPath}" Classes="elbwald-muted" FontSize="10" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding FilesAnalyzedText}" FontSize="11" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding IssueSummaryText}" Classes="elbwald-muted" FontSize="10" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding MissingCaptureDateText}" Classes="elbwald-muted" FontSize="10" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding MetadataQualityText}" Classes="elbwald-muted" FontSize="10" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="330" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock IsVisible="{Binding HasNoEndpoints}"
                               Text="Noch keine aktiven Speicherorte vorhanden. Lege Import-Wartehalle, Bibliothek oder weitere Endpunkte zuerst in den Einstellungen fest."
                               Classes="elbwald-muted"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>



        <Border Grid.Row="4" Classes="elbwald-card" Padding="16">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Datum &amp; Metadatenqualität" Classes="elbwald-section-title" />
                        <TextBlock Text="{Binding MetadataQualitySummary}" Classes="elbwald-muted" FontSize="10" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="elbwald-secondary-button"
                            Command="{Binding OpenMetadataCommand}"
                            Content="Metadaten öffnen" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                    <Border Classes="elbwald-soft-card" Padding="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Ohne Aufnahmedatum" Classes="elbwald-muted" FontSize="9" />
                            <TextBlock Text="{Binding MissingCaptureDateCount}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Datum-basierte Sortierung eingeschränkt" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="elbwald-soft-card" Padding="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Datumskonflikte" Classes="elbwald-muted" FontSize="9" />
                            <TextBlock Text="{Binding ConflictingCaptureDateCount}" Foreground="{DynamicResource ElbwaldWarningBrush}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="EXIF/GPS-Datumsquellen &gt; 24 h auseinander" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="elbwald-soft-card" Padding="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Unplausibles Datum" Classes="elbwald-muted" FontSize="9" />
                            <TextBlock Text="{Binding SuspiciousCaptureDateCount}" Foreground="{DynamicResource ElbwaldWarningBrush}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Vor 1900 oder in der Zukunft" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Classes="elbwald-soft-card" Padding="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Ohne Abmessungen" Classes="elbwald-muted" FontSize="9" />
                            <TextBlock Text="{Binding MissingDimensionsCount}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Preview-/Bildfunktionen ggf. eingeschränkt" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Classes="elbwald-soft-card" Padding="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Lesefehler" Classes="elbwald-muted" FontSize="9" />
                            <TextBlock Text="{Binding MetadataErrorCount}" Foreground="{DynamicResource ElbwaldWarningBrush}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MetadataErrorSummary}" Classes="elbwald-muted" FontSize="9" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Die Qualitätsprüfung ist read-only. Kameraangaben, GPS oder EXIF an sich sind nicht verpflichtend; Elbwald meldet nur belastbare Auffälligkeiten."
                           Classes="elbwald-muted"
                           FontSize="9"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Border Grid.Row="7" Classes="elbwald-card" Padding="14">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Auffälligkeiten" Classes="elbwald-section-title" />
                        <TextBlock Text="{Binding IssueFilterSummary}" Classes="elbwald-muted" FontSize="9" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="elbwald-secondary-button"
                            Command="{Binding OpenDiagnosticsCommand}"
                            Content="Protokoll öffnen" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,170,170" ColumnSpacing="10" IsVisible="{Binding HasIssues}">
                    <TextBox Text="{Binding IssueSearchText, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Auffälligkeiten durchsuchen …" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding IssueSeverityFilters}"
                              SelectedItem="{Binding SelectedIssueSeverity}" />
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding IssueAreaFilters}"
                              SelectedItem="{Binding SelectedIssueArea}" />
                </Grid>

                <Grid Grid.Row="2">
                    <!-- ListBox keeps the issue surface virtualized. The previous
                         ItemsControl inside a ScrollViewer instantiated every issue card at
                         once and could stall the UI for large health reports. -->
                    <ListBox IsVisible="{Binding HasFilteredIssues}"
                             ItemsSource="{Binding FilteredIssues}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LibraryHealthIssueItemViewModel">
                                <Border Classes="elbwald-soft-card" Padding="14" Margin="0,0,0,10">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="110,130,160,*" ColumnSpacing="12">
                                            <TextBlock Text="{Binding Severity}"
                                                       Foreground="{DynamicResource ElbwaldAccentBrush}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Area}" Classes="elbwald-muted" FontSize="10" />
                                            <TextBlock Grid.Column="2" Text="{Binding EndpointName}" FontSize="10" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="3" Text="{Binding Kind}" Classes="elbwald-muted" FontSize="10" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{Binding Message}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock IsVisible="{Binding HasPath}" Text="{Binding Path}" Classes="elbwald-muted" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock IsVisible="{Binding HasNoIssues}"
                               Text="Keine Auffälligkeiten gefunden. Alle aktuell aktivierten Endpunkte sind sauber durchgelaufen."
                               Classes="elbwald-muted"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <TextBlock IsVisible="{Binding HasNoMatchingIssues}"
                               Text="Für die gewählten Filter wurden keine Auffälligkeiten gefunden."
                               Classes="elbwald-muted"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
