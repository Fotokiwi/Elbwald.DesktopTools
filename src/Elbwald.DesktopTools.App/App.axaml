<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Elbwald.DesktopTools.App.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <SolidColorBrush x:Key="ElbwaldAccentBrush" Color="#286A4A" />
        <SolidColorBrush x:Key="ElbwaldAccentHoverBrush" Color="#337A58" />
        <SolidColorBrush x:Key="ElbwaldAccentSoftBrush" Color="#E8F2EC" />
        <SolidColorBrush x:Key="ElbwaldAccentSoftStrongBrush" Color="#D2E8DA" />
        <SolidColorBrush x:Key="ElbwaldSidebarBrush" Color="#F4F8F5" />
        <SolidColorBrush x:Key="ElbwaldPageBrush" Color="#FAFCFA" />
        <SolidColorBrush x:Key="ElbwaldCardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ElbwaldCardHoverBrush" Color="#F5FAF7" />
        <SolidColorBrush x:Key="ElbwaldWarmCardBrush" Color="#F8F3EA" />
        <SolidColorBrush x:Key="ElbwaldBorderBrush" Color="#DCE5DF" />
        <SolidColorBrush x:Key="ElbwaldTextBrush" Color="#17251F" />
        <SolidColorBrush x:Key="ElbwaldMutedTextBrush" Color="#66756D" />
        <SolidColorBrush x:Key="ElbwaldWarningBrush" Color="#A96200" />
        <SolidColorBrush x:Key="ElbwaldWarningSoftBrush" Color="#FFF1D6" />
        <SolidColorBrush x:Key="ElbwaldDangerBrush" Color="#A64235" />
        <SolidColorBrush x:Key="ElbwaldDangerSoftBrush" Color="#FBE8E5" />

        <StreamGeometry x:Key="ElbwaldIconTree">M12 2L5 11H8L3 18H10V22H14V18H21L16 11H19L12 2Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconHome">M10 20V14H14V20H19V12H22L12 3L2 12H5V20Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconCamera">M9 2L7.17 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V6C22 4.9 21.1 4 20 4H16.83L15 2H9ZM12 17C9.24 17 7 14.76 7 12S9.24 7 12 7S17 9.24 17 12S14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12S10.34 15 12 15S15 13.66 15 12S13.66 9 12 9Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconMusic">M12 3V13.55A4 4 0 1 0 14 17V7H18V3H12Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconTool">M4 4H20V20H4V4ZM7 7V17H17V7H7Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconArrowRight">M12 4L10.59 5.41L16.17 11H4V13H16.17L10.59 18.59L12 20L20 12Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconCheck">M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconFolder">M10 4H4C2.9 4 2 4.9 2 6V18C2 19.1 2.9 20 4 20H20C21.1 20 22 19.1 22 18V8C22 6.9 21.1 6 20 6H12L10 4Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconEye">M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5S21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17C9.24 17 7 14.76 7 12S9.24 7 12 7S17 9.24 17 12S14.76 17 12 17ZM12 9C10.34 9 9 10.34 9 12S10.34 15 12 15S15 13.66 15 12S13.66 9 12 9Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconWarning">M1 21H23L12 2L1 21ZM13 18H11V16H13V18ZM13 14H11V10H13V14Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconSearch">M9.5 3A6.5 6.5 0 1 0 13.6 14.55L19.05 20L20.5 18.55L15.05 13.1A6.5 6.5 0 0 0 9.5 3ZM9.5 5A4.5 4.5 0 1 1 9.5 14A4.5 4.5 0 0 1 9.5 5Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconEdit">M4 17.25V21H7.75L18.81 9.94L15.06 6.19L4 17.25ZM21.71 7.04C22.1 6.65 22.1 6.02 21.71 5.63L19.37 3.29C18.98 2.9 18.35 2.9 17.96 3.29L16.13 5.12L19.88 8.87L21.71 7.04Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconBackup">M4 3H20C21.1 3 22 3.9 22 5V19C22 20.1 21.1 21 20 21H4C2.9 21 2 20.1 2 19V5C2 3.9 2.9 3 4 3ZM5 6V10H19V6H5ZM12 12C9.79 12 8 13.79 8 16S9.79 20 12 20S16 18.21 16 16S14.21 12 12 12ZM12 14C13.1 14 14 14.9 14 16S13.1 18 12 18S10 17.1 10 16S10.9 14 12 14Z</StreamGeometry>
        <StreamGeometry x:Key="ElbwaldIconSettings">M19.14 12.94C19.18 12.63 19.2 12.32 19.2 12S19.18 11.37 19.13 11.06L21.23 9.42L19.23 5.96L16.74 6.96C16.24 6.58 15.69 6.26 15.09 6.03L14.71 3.39H10.71L10.32 6.03C9.73 6.27 9.18 6.59 8.68 6.97L6.19 5.96L4.19 9.42L6.29 11.06C6.24 11.37 6.21 11.69 6.21 12S6.24 12.63 6.29 12.94L4.19 14.58L6.19 18.04L8.68 17.04C9.18 17.42 9.73 17.74 10.32 17.97L10.71 20.61H14.71L15.09 17.97C15.69 17.73 16.24 17.41 16.74 17.03L19.23 18.04L21.23 14.58L19.14 12.94ZM12.71 15.5A3.5 3.5 0 1 1 12.71 8.5A3.5 3.5 0 0 1 12.71 15.5Z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource ElbwaldPageBrush}" />
        </Style>

        <Style Selector="Border.elbwald-card">
            <Setter Property="Background" Value="{DynamicResource ElbwaldCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElbwaldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style Selector="Border.elbwald-soft-card">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style Selector="TextBlock.elbwald-title">
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldTextBrush}" />
            <Setter Property="FontSize" Value="38" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.elbwald-section-title">
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldTextBrush}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TextBlock.elbwald-muted">
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldMutedTextBrush}" />
        </Style>

        <Style Selector="ListBox.elbwald-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBox.elbwald-nav > ListBoxItem">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="ListBox.elbwald-nav > ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentSoftBrush}" />
        </Style>

        <Style Selector="ListBox.elbwald-nav > ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentSoftStrongBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldAccentBrush}" />
        </Style>

        <Style Selector="Border.elbwald-recovery-item">
            <Setter Property="Background" Value="{DynamicResource ElbwaldPageBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElbwaldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style Selector="Button.elbwald-primary-button">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.elbwald-primary-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentHoverBrush}" />
        </Style>

        <Style Selector="Button.elbwald-secondary-button">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ElbwaldAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElbwaldAccentSoftStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.elbwald-secondary-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ElbwaldAccentSoftStrongBrush}" />
        </Style>

        <Style Selector="Button.elbwald-tool-card">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="Background" Value="{DynamicResource ElbwaldCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElbwaldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style Selector="Button.elbwald-tool-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource ElbwaldCardHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ElbwaldAccentSoftStrongBrush}" />
        </Style>
    </Application.Styles>
</Application>
