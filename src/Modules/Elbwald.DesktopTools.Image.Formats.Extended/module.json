{
  "id": "elbwald.image.formats.extended",
  "name": "Erweiterte Bildformate",
  "description": "Optionale Bildformate über Magick.NET: WebP und TIFF mit Vollbild-Decoding, Metadatenlesen, Export und Thumbnails; HEIC/HEIF, AVIF und JPEG 2000 zunächst mit geprüfter Formaterkennung.",
  "version": "0.7.0",
  "apiVersion": 2,
  "minimumHostVersion": "0.0.1",
  "assembly": "Elbwald.DesktopTools.Image.Formats.Extended.dll",
  "enabled": true,
  "capabilities": [
    "media.format.provider",
    "media.decode.image.provider",
    "media.image.webp.decode",
    "media.image.tiff.decode",
    "media.image.webp.detect",
    "media.image.tiff.detect",
    "media.image.heic.detect",
    "media.image.heif.detect",
    "media.image.avif.detect",
    "media.image.jpeg2000.detect",
    "media.metadata.image.reader-provider",
    "media.image.webp.metadata.read",
    "media.image.tiff.metadata.read",
    "media.export.image.provider",
    "media.image.webp.export",
    "media.image.tiff.export",
    "media.thumbnail.image.provider",
    "media.image.webp.thumbnail",
    "media.image.tiff.thumbnail"
  ],
  "permissions": [
    "ReadMedia"
  ],
  "dependencies": []
}
