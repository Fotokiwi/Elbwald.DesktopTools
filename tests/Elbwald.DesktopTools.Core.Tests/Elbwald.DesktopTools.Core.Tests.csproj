<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Elbwald.DesktopTools.Contracts/Elbwald.DesktopTools.Contracts.csproj" />
        <ProjectReference Include="../../src/Elbwald.DesktopTools.Core/Elbwald.DesktopTools.Core.csproj" />
        <ProjectReference Include="../../src/Modules/Elbwald.DesktopTools.PhotoSort/Elbwald.DesktopTools.PhotoSort.csproj" />
        <ProjectReference Include="../../src/Modules/Elbwald.DesktopTools.Image.Formats.Extended/Elbwald.DesktopTools.Image.Formats.Extended.csproj"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="../Fixtures/Elbwald.DesktopTools.TestModule/Elbwald.DesktopTools.TestModule.csproj"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <Target Name="CopyTestModule" AfterTargets="Build">
        <PropertyGroup>
            <TestModuleOutput>$(MSBuildProjectDirectory)/../Fixtures/Elbwald.DesktopTools.TestModule/bin/$(Configuration)/$(TargetFramework)/</TestModuleOutput>
            <TestModuleDestination>$(TargetDir)TestModules/TestModule/</TestModuleDestination>
            <ExtendedImageFormatsModuleOutput>$(MSBuildProjectDirectory)/../../src/Modules/Elbwald.DesktopTools.Image.Formats.Extended/bin/$(Configuration)/$(TargetFramework)/</ExtendedImageFormatsModuleOutput>
            <ExtendedImageFormatsModuleDestination>$(TargetDir)TestModules/Image.Formats.Extended/</ExtendedImageFormatsModuleDestination>
        </PropertyGroup>

        <ItemGroup>
            <TestModuleFiles Include="$(TestModuleOutput)**/*" />
            <ExtendedImageFormatsModuleFiles Include="$(ExtendedImageFormatsModuleOutput)**/*" />
        </ItemGroup>

        <MakeDir Directories="$(TestModuleDestination)" />
        <MakeDir Directories="$(ExtendedImageFormatsModuleDestination)" />

        <Copy
            SourceFiles="@(TestModuleFiles)"
            DestinationFiles="@(TestModuleFiles->'$(TestModuleDestination)%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true" />

        <Copy
            SourceFiles="@(ExtendedImageFormatsModuleFiles)"
            DestinationFiles="@(ExtendedImageFormatsModuleFiles->'$(ExtendedImageFormatsModuleDestination)%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true" />
    </Target>

</Project>
